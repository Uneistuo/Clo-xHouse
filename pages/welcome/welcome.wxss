/* 欢迎页：冷调底 + 全局光晕 + 依次淡入上移动画（Standard 玻璃引导卡） */

.welcome-page {
  position: relative;
  min-height: 100vh;
  background: transparent;
  overflow: hidden;
}

/* ===== 背景光晕：统一由全局 page::before / ::after 提供 ===== */
.glow {
  display: none;
}

.welcome-wrap {
  position: relative;
  z-index: 1;
  padding: 112rpx 56rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* ===== 品牌 + 成功标记 ===== */
.wc-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wc-ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: ringPulse 1.8s ease-out infinite;
}
.wc-ring-inner {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary);
}
@keyframes ringPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(123, 140, 247, 0.28);
  }
  70% {
    box-shadow: 0 0 0 32rpx rgba(123, 140, 247, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(123, 140, 247, 0);
  }
}
.wc-brand-title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}

.wc-title {
  margin-top: 40rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-1);
}
.wc-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--primary-dark);
}
.wc-hello {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* ===== 功能引导（Standard 玻璃） ===== */
.wc-guide {
  width: 100%;
  margin-top: 64rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 16rpx 32rpx;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
}
.guide-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  text-align: left;
}
.guide-item:last-child {
  border-bottom: none;
}
.guide-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-tint);
  color: var(--primary-dark);
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.guide-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.guide-sub {
  font-size: var(--font-xs);
  color: var(--text-2);
  margin-top: 8rpx;
}

/* ===== 主按钮（渐变是状态） ===== */
.wc-btn {
  width: 100%;
  margin-top: 64rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff;
  line-height: 1.4;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-radius: var(--radius-pill);
  padding: 24rpx 0;
  box-shadow: var(--shadow-primary);
  transition:
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}
.wc-btn::after {
  border: none;
}
.wc-btn:active {
  transform: scale(var(--scale-press));
  box-shadow: 0 8rpx 20rpx rgba(123, 140, 247, 0.18);
}

.wc-foot {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ===== 依次淡入上移 ===== */
.anim {
  opacity: 0;
  animation: fadeUp 0.5s ease forwards;
}
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-motion: reduce) {
  .anim {
    opacity: 1;
    animation: none !important;
  }
  .wc-ring {
    animation: none !important;
  }
  .wc-btn {
    transition: none !important;
  }
  .wc-btn:active {
    transform: none;
  }
}
