/* 注册 + 绑定页样式（清透质感：步骤条主色渐变 + Standard 玻璃面板 + Wash 输入框） */

.reg-page {
  position: relative;
  min-height: 100vh;
  background: transparent;
  overflow: hidden;
}

/* ===== 背景光晕：统一由全局 page::before / ::after 提供 ===== */
.glow {
  display: none;
}

.reg-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  padding: 80rpx 56rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 顶部标题区 ===== */
.reg-brand {
  text-align: center;
  margin-bottom: 48rpx;
}
.reg-brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: 12rpx;
  text-indent: 12rpx;
}
.reg-step-title {
  font-size: var(--font-h3);
  font-weight: 700;
  color: var(--text-1);
  margin-top: 16rpx;
}

/* ===== 步骤条（Wash 玻璃轨道 + 主色渐变节点） ===== */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.step-node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  background: var(--bg-subtle);
  color: var(--text-3);
  border: 1rpx solid var(--glass-border);
  transition: all 0.24s ease;
}
.step-node.active {
  border-color: transparent;
  background: var(--primary-tint);
  color: var(--primary-dark);
  transform: scale(1.06);
  box-shadow: 0 0 0 8rpx rgba(123, 140, 247, 0.12);
}
.step-node.done {
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  border-color: transparent;
}
.step-line {
  width: 96rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 16rpx;
  transition: background 0.24s ease;
}
.step-line.fill {
  background: linear-gradient(90deg, #8a9bf9 0%, #b3a1fb 100%);
}
.steps-labels {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.steps-labels text {
  width: 168rpx;
  text-align: center;
}
.steps-labels text.on {
  color: var(--text-2);
}

.resume-hint {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-input);
  text-align: center;
}

/* ===== 内容卡片（Standard 玻璃） ===== */
.panel {
  width: 100%;
  margin-top: 40rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 40rpx 40rpx 48rpx;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
}

/* ===== 输入项（Wash 层玻璃化） ===== */
.field {
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-input);
  padding: 16rpx 24rpx;
  transition:
    background 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}
.field.is-focus {
  background: rgba(255, 255, 255, 0.85);
  border-color: transparent;
  box-shadow: 0 0 0 6rpx rgba(123, 140, 247, 0.14);
}
.field.is-error {
  background: rgba(255, 255, 255, 0.85);
  border-color: var(--danger);
  box-shadow: 0 0 0 6rpx rgba(224, 93, 87, 0.08);
}
.field-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.field-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-1);
  line-height: 1.4;
}
.ph {
  color: var(--text-placeholder);
}
.field-tip {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 8rpx;
  padding-left: 8rpx;
}
.tip-link {
  color: var(--primary-dark);
  margin-left: 16rpx;
  text-decoration: underline;
}

/* ===== 绑定方式切换（Wash 轨道 + 白色胶囊滑块） ===== */
.segmented {
  display: flex;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-pill);
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  transition: all 0.2s ease;
}
.seg-item.active {
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary-dark);
  font-weight: 700;
  box-shadow: var(--shadow-soft-1);
}
.store-form {
  margin-top: 32rpx;
}

/* ===== 主按钮（渐变是状态） ===== */
.login-btn {
  width: 100%;
  margin-top: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff;
  line-height: 1.4;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-radius: var(--radius-pill);
  padding: 24rpx 0;
  box-shadow: var(--shadow-primary);
  transition:
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}
.login-btn::after {
  border: none;
}
.login-btn:active {
  transform: scale(var(--scale-press));
  box-shadow: 0 8rpx 20rpx rgba(123, 140, 247, 0.18);
}
.login-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}
.btn-loading {
  position: relative;
  color: transparent !important;
  pointer-events: none;
}
.login-btn.btn-loading::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  margin-top: -17rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: btnSpin 0.8s linear infinite;
}
@keyframes btnSpin {
  to {
    transform: rotate(360deg);
  }
}

.register-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}
.back-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}

/* ===== 第 3 步：完成 ===== */
.done-panel {
  text-align: center;
}
.done-mark {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-tint);
  color: var(--primary);
  font-size: 64rpx;
  box-shadow: var(--shadow-primary);
  animation: popIn 0.42s cubic-bezier(0.18, 0.9, 0.32, 1.3);
}
@keyframes popIn {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
.done-title {
  font-size: var(--font-h3);
  font-weight: 700;
  color: var(--text-1);
  margin-top: 24rpx;
}
.info-card {
  margin-top: 32rpx;
  background: var(--bg-subtle);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-input);
  padding: 8rpx 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--text-3);
}
.info-value {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
}
.role-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}

/* ===== 底部 ===== */
.foot {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.foot-sub {
  margin-top: 16rpx;
}
.foot-link {
  color: var(--primary-dark);
  font-weight: 600;
  margin-left: 8rpx;
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .panel {
    background: #ffffff;
  }
  .field {
    background: #f4f6fa;
    border-color: rgba(29, 34, 43, 0.1);
  }
  .field.is-focus {
    background: #ffffff;
  }
  .segmented {
    background: #f2f4f8;
  }
  .step-line {
    background: rgba(29, 34, 43, 0.08);
  }
}
@media (prefers-reduced-motion: reduce) {
  .step-node,
  .step-line,
  .field,
  .seg-item,
  .login-btn,
  .done-mark {
    transition: none !important;
    animation: none !important;
  }
  .login-btn:active {
    transform: none;
  }
  .step-node.active {
    transform: none;
  }
}
