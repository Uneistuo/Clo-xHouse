/* 首页样式（清透质感：Hero 销售额卡 + Standard 玻璃指标卡 + Dense 低库存列表） */
.home {
  background: transparent;
  padding: 20rpx 30rpx 0;
}

.head {
  padding: 10rpx 6rpx 24rpx;
  position: relative;
}
.head-date {
  font-size: 24rpx;
  color: var(--text-2);
}
.head-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ===== 销售额主卡（Hero 玻璃） ===== */
.sales-card {
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 40rpx 36rpx 34rpx;
  border-radius: var(--radius-hero);
  color: #fff;
  box-shadow: var(--shadow-primary), var(--inner-light);
  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);
}
.sales-label {
  font-size: 26rpx;
  opacity: 0.92;
}
/* 总额与单数同一行：基线对齐，两者字号各自保持不变 */
.sales-figure-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}
.sales-num {
  font-size: 84rpx;
  font-weight: bold;
  line-height: 1.25;
}
.sales-note {
  font-size: 22rpx;
  opacity: 0.78;
  margin-left: 20rpx;
}

/* ===== 双卡（Standard 玻璃） ===== */
.duo-row {
  display: flex;
  margin-top: 24rpx;
}
.duo-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 30rpx;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
  transition: transform var(--duration-fast) var(--ease-out);
}
.duo-card:first-child {
  margin-right: 24rpx;
}
.duo-card:active {
  transform: scale(var(--scale-press));
}
.duo-label {
  font-size: 24rpx;
  color: var(--text-2);
}
.duo-num {
  font-size: 52rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-top: 8rpx;
}

/* ===== 三栏（Standard 玻璃） ===== */
.tri-row {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  margin-top: 24rpx;
  padding: 26rpx 0;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
  transition: transform var(--duration-fast) var(--ease-out);
}
.tri-row:active {
  transform: scale(var(--scale-press));
}
.tri-item {
  flex: 1;
  text-align: center;
}
.tri-num {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-1);
}
.tri-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* ===== 分区标题行 ===== */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 40rpx 6rpx 20rpx;
}
.section-head .section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-1);
}
.section-link {
  font-size: 26rpx;
  color: var(--primary-dark);
}

/* 底部占位：悬浮玻璃 TabBar（108rpx + 16rpx 间距）+ 安全区 */
.page-bottom-space {
  height: calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 书签式周期切换（Hero 卡内的状态切换） ===== */
.sales-card {
  padding: 0;
  overflow: hidden;
}
.bookmark-tabs {
  /* 未选中书签的叠加色；选中项保持透明，直接透出卡片渐变 */
  --bookmark-tab-bg: rgba(255, 255, 255, 0.16);
  /* 凹角过渡色：取卡片渐变在书签下缘处的近似值 */
  --bookmark-fillet-left: #979dfa;
  --bookmark-fillet-right: #979dfa;
  display: flex;
  background: transparent;
}
.bookmark-tabs.range-week {
  --bookmark-fillet-right: #a19efa;
}
.bookmark-tabs.range-month {
  --bookmark-fillet-left: #a19efa;
  --bookmark-fillet-right: #a19efa;
}
.bookmark-tab {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 22rpx 0;
  color: rgba(255, 255, 255, 0.85);
  /* 未选中：在卡片底色上叠一层浅色，比卡片更浅 */
  background: var(--bookmark-tab-bg);
}
.bookmark-tab.active {
  z-index: 1;
  color: #ffffff;
  font-weight: 700;
  /* 选中：主体透出卡片渐变；顶部两角用未选中色补出圆角 */
  background-color: transparent;
  background-image:
    radial-gradient(circle 18rpx at 100% 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx),
    radial-gradient(circle 18rpx at 0 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position:
    left top,
    right top;
  background-size: 18rpx 18rpx;
  background-repeat: no-repeat;
}
.bookmark-tabs.range-today .bookmark-tab.active {
  background-image: radial-gradient(circle 18rpx at 0 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position: right top;
}
.bookmark-tabs.range-month .bookmark-tab.active {
  background-image: radial-gradient(circle 18rpx at 100% 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position: left top;
}
.bookmark-tab.active::before,
.bookmark-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  pointer-events: none;
}
.bookmark-tab.active::before {
  left: -16rpx;
  background: radial-gradient(circle 16rpx at 0 0, transparent 14rpx, var(--bookmark-fillet-left) 16rpx);
}
.bookmark-tab.active::after {
  right: -16rpx;
  background: radial-gradient(circle 16rpx at 100% 0, transparent 14rpx, var(--bookmark-fillet-right) 16rpx);
}
.sales-body {
  padding: 26rpx 36rpx 34rpx;
}

.card .section-head {
  margin: 0 0 20rpx;
}

/* ===== 趋势图 ===== */
.trend {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 200rpx;
}
.trend-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.trend-bar {
  width: 100%;
  max-width: 48rpx;
  min-width: 24rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: rgba(123, 140, 247, 0.18);
  transition: background 0.15s;
}
.trend-bar.active {
  background: linear-gradient(180deg, #8a9bf9 0%, #7b8cf7 100%);
}
.trend-date {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 10rpx;
}
.trend-date.active {
  color: var(--primary);
  font-weight: 600;
}

.trend-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--hairline);
}
.trend-info-date {
  font-size: 24rpx;
  color: var(--text-2);
}
.trend-info-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}
.trend-info-orders {
  font-size: 22rpx;
  color: var(--text-2);
}

/* ===== 低库存提醒 ===== */
.low-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.low-item:last-child {
  border-bottom: none;
}
.low-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  margin-right: 20rpx;
}
.low-stock {
  font-size: 26rpx;
}
.low-arrow {
  font-size: 30rpx;
  color: var(--text-2);
  margin-left: 12rpx;
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .sales-card {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .trend-bar {
    transition: none;
  }
  .duo-card:active,
  .tri-row:active {
    transform: none;
  }
}
