/* 首页样式（清透质感：Hero 销售额卡 + Standard 玻璃指标卡 + Dense 低库存列表） */
.home {
  background: transparent;
  padding: 24rpx 24rpx 0;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 8rpx 0 24rpx;
  position: relative;
}
.head-left {
  flex: 1;
  min-width: 0;
}
.head-date {
  font-size: 24rpx;
  color: var(--text-2);
}
.head-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.head-action {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: 0 0 4rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-tint);
  border: 1rpx solid var(--glass-border);
  border-radius: 50%;
  transition: transform var(--duration-fast) var(--ease-out);
}
.head-action:active {
  transform: scale(var(--scale-press));
}
.head-action-icon {
  font-size: var(--font-h3);
  color: var(--primary-dark);
}

/* ===== 销售额主卡（Hero 玻璃） ===== */
.sales-card {
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 40rpx 32rpx 32rpx;
  border-radius: var(--radius-hero);
  color: #fff;
  box-shadow: var(--shadow-primary), var(--inner-light);
  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);
}
.sales-label {
  font-size: 26rpx;
  opacity: 0.92;
}
/* 总额与单数同一行：基线对齐，两者字号各自保持不变 */
.sales-figure-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.sales-num {
  font-size: var(--font-h1);
  font-weight: bold;
  line-height: 1.25;
}
.sales-note {
  font-size: 22rpx;
  opacity: 0.78;
  margin-left: 20rpx;
}

/* ===== 数据卡：商品概览（上）+ 近 7 天销售（下） ===== */
.stat-goods {
  display: flex;
  align-items: stretch;
  /* 抵消卡片左右内边距：三栏按整卡宽度等分，栏与栏之间才分得开 */
  margin: 0 -32rpx;
  /* 整行可点，进商品页 */
  transition: opacity var(--duration-fast) var(--ease-out);
}
.stat-goods:active {
  opacity: 0.6;
}
/* 每栏等宽，文字在本栏内居中 */
.tri-item {
  flex: 1;
  text-align: center;
}
.stat-divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 24rpx 0;
}
.tri-num {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-1);
}
.tri-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

/* ===== 分区标题行 ===== */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 40rpx 8rpx 24rpx;
}
.section-head .section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-1);
}

/* 底部占位：悬浮玻璃 TabBar（108rpx + 16rpx 间距）+ 安全区 */
.page-bottom-space {
  height: calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 书签式周期切换（Hero 卡内的状态切换） ===== */
.sales-card {
  padding: 0;
  overflow: hidden;
}
.bookmark-tabs {
  /* 未选中书签的叠加色；选中项保持透明，直接透出卡片渐变 */
  --bookmark-tab-bg: rgba(255, 255, 255, 0.16);
  /* 凹角过渡色：取卡片渐变在书签下缘处的近似值 */
  --bookmark-fillet-left: #979dfa;
  --bookmark-fillet-right: #979dfa;
  display: flex;
  background: transparent;
}
.bookmark-tabs.range-week {
  --bookmark-fillet-right: #a19efa;
}
.bookmark-tabs.range-month {
  --bookmark-fillet-left: #a19efa;
  --bookmark-fillet-right: #a19efa;
}
.bookmark-tab {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: var(--font-xs);
  padding: 24rpx 0;
  color: rgba(255, 255, 255, 0.85);
  /* 未选中：在卡片底色上叠一层浅色，比卡片更浅 */
  background: var(--bookmark-tab-bg);
}
.bookmark-tab.active {
  z-index: 1;
  color: #ffffff;
  font-weight: 700;
  /* 选中：主体透出卡片渐变；顶部两角用未选中色补出圆角 */
  background-color: transparent;
  background-image:
    radial-gradient(circle 18rpx at 100% 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx),
    radial-gradient(circle 18rpx at 0 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position:
    left top,
    right top;
  background-size: 18rpx 18rpx;
  background-repeat: no-repeat;
}
.bookmark-tabs.range-today .bookmark-tab.active {
  background-image: radial-gradient(circle 18rpx at 0 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position: right top;
}
.bookmark-tabs.range-month .bookmark-tab.active {
  background-image: radial-gradient(circle 18rpx at 100% 100%, transparent 16rpx, var(--bookmark-tab-bg) 18rpx);
  background-position: left top;
}
.bookmark-tab.active::before,
.bookmark-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  pointer-events: none;
}
.bookmark-tab.active::before {
  left: -16rpx;
  background: radial-gradient(circle 16rpx at 0 0, transparent 14rpx, var(--bookmark-fillet-left) 16rpx);
}
.bookmark-tab.active::after {
  right: -16rpx;
  background: radial-gradient(circle 16rpx at 100% 0, transparent 14rpx, var(--bookmark-fillet-right) 16rpx);
}
.sales-body {
  padding: 24rpx 32rpx 32rpx;
}

.card .section-head {
  margin: 0 0 20rpx;
}

/* ===== 趋势图 ===== */
.trend {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 200rpx;
}
.trend-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.trend-bar {
  width: 100%;
  max-width: 48rpx;
  min-width: 24rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: rgba(123, 140, 247, 0.18);
  transition: background 0.15s;
}
.trend-bar.active {
  background: linear-gradient(180deg, #8a9bf9 0%, #7b8cf7 100%);
}
.trend-date {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.trend-date.active {
  color: var(--primary);
  font-weight: 600;
}

.trend-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}
.trend-info-date {
  font-size: 24rpx;
  color: var(--text-2);
}
.trend-info-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}
.trend-info-orders {
  font-size: 22rpx;
  color: var(--text-2);
}

.todo-modal {
  width: 600rpx;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg-overlay);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-hero);
  box-shadow: var(--shadow-float), var(--inner-light);
  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);
  animation: modal-in var(--duration-slow) var(--ease-spring) both;
}
.todo-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.todo-modal-title {
  font-size: var(--font-h3);
  font-weight: bold;
  color: var(--text-1);
}
.todo-close {
  width: 48rpx;
  height: 48rpx;
  margin-right: -8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-h3);
  color: var(--text-3);
  border-radius: 50%;
}
.todo-close:active {
  opacity: 0.5;
}
.todo-body {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.todo-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--hairline);
  transition: opacity var(--duration-fast) var(--ease-out);
}
.todo-item:last-child {
  border-bottom: none;
}
.todo-item:active {
  opacity: 0.6;
}
.todo-bar {
  width: 4rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border-radius: 2rpx;
  background: var(--primary);
}
.todo-item.warning .todo-bar {
  background: var(--warning);
}
.todo-item.danger .todo-bar {
  background: var(--danger);
}
.todo-icon {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: var(--font-h3);
  color: var(--primary);
}
.todo-item.warning .todo-icon {
  color: var(--warning);
}
.todo-item.danger .todo-icon {
  color: var(--danger);
}
.todo-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-1);
}
.todo-count {
  flex-shrink: 0;
  min-width: 56rpx;
  padding: 4rpx 16rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-26);
  font-weight: 700;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: var(--radius-pill);
}
.todo-item.warning .todo-count {
  color: var(--warning);
  background: var(--warning-tint);
}
.todo-item.danger .todo-count {
  color: var(--danger);
  background: var(--danger-tint);
}
.todo-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-body);
  color: var(--text-3);
  opacity: 0.6;
}
.todo-empty {
  padding: 64rpx 0 72rpx;
  text-align: center;
}
.todo-empty-icon {
  font-size: var(--fs-96);
  color: var(--success);
  opacity: 0.4;
  margin-bottom: 24rpx;
}
.todo-empty-text {
  font-size: var(--fs-26);
  color: var(--text-3);
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .sales-card,
  .todo-modal {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .todo-modal {
    background: #ffffff;
  }
}
@media (prefers-reduced-motion: reduce) {
  .trend-bar,
  .todo-item {
    transition: none;
  }
  .todo-modal {
    animation: none;
  }
}

/* ===== 快捷操作（销售额主卡下方的高频入口） ===== */
.quick-actions {
  display: flex;
  gap: 24rpx;
  margin: 24rpx 0;
}
.quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40rpx;
  padding: 24rpx 32rpx 24rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  transition: transform var(--duration-fast) var(--ease-out);
}
.quick-item:active {
  transform: scale(var(--scale-press));
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: var(--radius-sm);
}
.quick-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-2);
}

/* ===== 销售环比标签 ===== */
.sales-compare {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.92);
}
.sales-compare .compare-arrow {
  font-size: 18rpx;
}
.sales-compare.up {
  color: #d4f5e4;
}
.sales-compare.down {
  color: #ffd4cc;
}

/* ===== 进场动效（错峰淡入，克制） ===== */
@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.home .anim-in {
  animation: card-in 340ms var(--ease-out) both;
  animation-delay: calc(var(--i, 0) * 70ms);
}
@media (prefers-reduced-motion: reduce) {
  .home .anim-in {
    animation: none;
  }
  .quick-item:active {
    transform: none;
  }
}
