<!--首页：经营看板（优化版：CSS 变量 + 统一空状态 + 加载态）-->
<view class="page home glow-page">
  <!-- 顶部日期与标题 -->
  <view class="head">
    <view class="head-date">{{dateText}}</view>
    <view class="head-title">经营看板</view>
  </view>

  <!-- 快捷操作（P1：高频路径前置，参考 fashion-mall 首页 grid） -->
  <view class="quick-actions anim-in" style="--i: 0">
    <view class="quick-item" bindtap="goCreateOrder">
      <view class="quick-icon icon icon-cash-register"></view>
      <view class="quick-text">
        <view class="quick-title">快速开单</view>
        <view class="quick-sub">进入开单页</view>
      </view>
    </view>
    <view class="quick-item" bindtap="goPhotoUpload">
      <view class="quick-icon icon icon-plus"></view>
      <view class="quick-text">
        <view class="quick-title">拍照上传</view>
        <view class="quick-sub">新增商品图片</view>
      </view>
    </view>
  </view>

  <!-- 销售额主卡（书签式周期切换） -->
  <view class="sales-card anim-in" style="--i: 1">
    <view class="bookmark-tabs range-{{rangeKey}}">
      <view wx:for="{{ranges}}" wx:key="key"
            class="bookmark-tab {{rangeKey === item.key ? 'active' : ''}}"
            data-key="{{item.key}}" bindtap="switchRange">{{item.text}}</view>
    </view>
    <view class="sales-body">
      <view class="sales-label">{{rangeLabel}}销售额</view>
      <view class="sales-figure-row">
        <view class="sales-num">￥{{periodSales}}</view>
        <view class="sales-note">共 {{periodOrders}} 单</view>
      </view>
      <view wx:if="{{compareText}}" class="sales-compare {{compareDirection}}">
        <text class="compare-arrow">{{compareDirection === 'up' ? '▲' : compareDirection === 'down' ? '▼' : '—'}}</text>
        <text>{{compareText}}</text>
      </view>
    </view>
  </view>

  <!-- 关键指标：待收款 / 本期订单 -->
  <view class="duo-row anim-in" style="--i: 2">
    <view class="duo-card" bindtap="goOrders">
      <view class="duo-label">待收款</view>
      <view class="duo-num">{{pendingOrders}}</view>
    </view>
    <view class="duo-card">
      <view class="duo-label">{{rangeLabel}}订单</view>
      <view class="duo-num">{{periodOrders}}</view>
    </view>
  </view>

  <!-- 今日待办（P1：待收款 / 低库存 / 会员生日） -->
  <view wx:if="{{todoList.length > 0}}" class="card todo-card anim-in" style="--i: 3">
    <view class="section-head">
      <view class="section-title">今日待办</view>
    </view>
    <view wx:for="{{todoList}}" wx:key="key" class="todo-item" data-key="{{item.key}}" bindtap="onTodoTap">
      <view class="todo-icon icon {{item.icon}}"></view>
      <view class="todo-text">{{item.text}}</view>
      <view class="todo-count">{{item.count}}</view>
      <view class="todo-arrow icon icon-chevron-right"></view>
    </view>
  </view>

  <!-- 商品概览 -->
  <view class="tri-row anim-in" style="--i: 4" bindtap="goGoods">
    <view class="tri-item">
      <view class="tri-num">{{goodsTotal}}</view>
      <view class="tri-label">全部商品</view>
    </view>
    <view class="tri-item">
      <view class="tri-num">{{goodsOnSale}}</view>
      <view class="tri-label">在售</view>
    </view>
    <view class="tri-item">
      <view class="tri-num">{{goodsOffSale}}</view>
      <view class="tri-label">下架</view>
    </view>
  </view>

  <!-- 近 7 天销售趋势（点选查看某日） -->
  <view class="card trend-card anim-in" style="--i: 5">
    <view class="section-head">
      <view class="section-title">近 7 天销售</view>
    </view>
    <view class="trend">
      <view wx:for="{{trend}}" wx:key="date" class="trend-col"
            data-index="{{index}}" bindtap="pickTrend">
        <view class="trend-bar-wrap">
          <view class="trend-bar {{index === trendIndex ? 'active' : ''}}" style="height: {{item.barH}}%;"></view>
        </view>
        <view class="trend-date {{index === trendIndex ? 'active' : ''}}">{{item.date}}</view>
      </view>
    </view>
    <view wx:if="{{trendSelected}}" class="trend-info">
      <text class="trend-info-date">{{trendSelected.date}}</text>
      <text class="trend-info-amount">￥{{trendSelected.amountText}}</text>
      <text class="trend-info-orders">{{trendSelected.orders}} 单</text>
    </view>
  </view>

  <!-- 低库存提醒（点击可去补货） -->
  <view wx:if="{{lowStock.length > 0}}" class="card anim-in" style="--i: 6">
    <view class="section-head">
      <view class="section-title">低库存提醒</view>
      <view class="section-link" bindtap="goGoods">全部商品<view class="icon icon-chevron-right"></view></view>
    </view>
    <view wx:for="{{lowStock}}" wx:key="id" class="low-item"
          data-id="{{item.id}}" bindtap="goRestock">
      <view class="low-name ellipsis">{{item.name}}</view>
      <view class="low-stock {{item.stock === 0 ? 'stock-zero' : 'stock-low'}}">剩余 {{item.stock}}</view>
      <view class="low-arrow icon icon-chevron-right"></view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
</view>
