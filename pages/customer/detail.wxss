/* 会员详情页样式（CSS 变量） */
.page { padding: 24rpx 24rpx 0; }

/* 会员信息卡 */
.profile-card { padding: 36rpx 32rpx; margin-bottom: 24rpx; }
.profile-top { display: flex; align-items: center; margin-bottom: 28rpx; }
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(225, 72, 60, 0.25);
}
.profile-name { font-size: 36rpx; font-weight: bold; color: var(--text-1); margin-bottom: 8rpx; }
.profile-phone { font-size: 26rpx; color: var(--text-2); letter-spacing: 1rpx; }
.profile-actions { display: flex; gap: 20rpx; border-top: 1rpx solid var(--divider); padding-top: 24rpx; }
.action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
}
.action-btn:active { opacity: 0.7; }
.action-btn.danger { color: var(--text-2); background: var(--bg-subtle); }

/* CRM 统计卡 */
.stats-card {
  display: flex;
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.stat-value.stat-time { font-size: 24rpx; color: var(--text-2); padding-top: 8rpx; }
.stat-label { font-size: 22rpx; color: var(--text-3); }

/* 消费记录卡片 */
.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border);
}
.order-card:active { background: var(--bg-subtle); }
.order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.order-no { font-size: 28rpx; font-weight: bold; color: var(--text-1); }
.order-status { font-size: 22rpx; }
.status-pending { color: var(--warning); }
.status-paid { color: var(--success); }
.status-done { color: var(--info); }
.status-cancelled { color: var(--text-3); }
.status-refunded { color: var(--danger); }
.order-bottom { display: flex; justify-content: space-between; align-items: center; }
.order-time { font-size: 22rpx; color: var(--text-3); }
.order-amount { font-size: 30rpx; font-weight: bold; color: var(--primary-dark); }

/* 编辑弹窗性别二选一 */
.gender-options {
  display: flex;
  flex: 1;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.gender-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-card);
}
.gender-option + .gender-option { border-left: 1rpx solid var(--border); }
.gender-option.active {
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}

/* 弹窗按钮：两按钮同高胶囊，取消略窄于确认 */
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* 加载提示 */
.loading-tip { text-align: center; padding: 24rpx 0 36rpx; font-size: 24rpx; color: var(--text-3); }
