/* 会员详情页样式 */
.page { padding: 24rpx 24rpx 0; }

/* 会员信息卡 */
.profile-card { padding: 36rpx 32rpx; margin-bottom: 24rpx; }
.profile-top { display: flex; align-items: center; margin-bottom: 28rpx; }
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(225, 72, 60, 0.1);
  color: #e1483c;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
}
.profile-name { font-size: 36rpx; font-weight: bold; color: #14161a; margin-bottom: 8rpx; }
.profile-phone { font-size: 26rpx; color: #5b616e; letter-spacing: 1rpx; }
.profile-actions { display: flex; gap: 20rpx; border-top: 1rpx solid #eceef1; padding-top: 24rpx; }
.action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #e1483c;
  background: rgba(225, 72, 60, 0.06);
}
.action-btn:active { opacity: 0.7; }
.action-btn.danger { color: #5b616e; background: #f4f5f7; }

/* CRM 统计卡 */
.stats-card {
  display: flex;
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #14161a;
  margin-bottom: 8rpx;
}
.stat-value.stat-time { font-size: 24rpx; color: #5b616e; padding-top: 8rpx; }
.stat-label { font-size: 22rpx; color: #9aa0ac; }

/* 消费记录卡片 */
.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.order-card:active { background: #f8f9fb; }
.order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.order-no { font-size: 28rpx; font-weight: bold; color: #14161a; }
.order-status { font-size: 22rpx; }
.status-pending { color: #d97706; }
.status-paid { color: #16a34a; }
.status-done { color: #5b616e; }
.status-cancelled { color: #9aa0ac; }
.status-refunded { color: #e1483c; }
.order-bottom { display: flex; justify-content: space-between; align-items: center; }
.order-time { font-size: 22rpx; color: #9aa0ac; }
.order-amount { font-size: 30rpx; font-weight: bold; color: #e1483c; }

/* 编辑弹窗性别二选一 */
.gender-options { display: flex; gap: 20rpx; }
.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 1rpx solid #e6e8ec;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #5b616e;
  background: #ffffff;
}
.gender-option.active {
  border-color: #e1483c;
  background: rgba(225, 72, 60, 0.06);
  color: #e1483c;
}

/* 加载提示 */
.loading-tip { text-align: center; padding: 24rpx 0 36rpx; font-size: 24rpx; color: #9aa0ac; }
