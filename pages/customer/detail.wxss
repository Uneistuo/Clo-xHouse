/* 会员详情页样式（清透质感：Standard 资料/统计卡 + Dense 消费记录） */
.page {
  padding: 24rpx 24rpx 0;
}

/* 会员信息卡 */
.profile-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(123, 140, 247, 0.25);
}
.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.profile-phone {
  font-size: 26rpx;
  color: var(--text-2);
  letter-spacing: 1rpx;
}
.profile-actions {
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid var(--hairline);
  padding-top: 24rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-input);
  font-size: 28rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  transition: opacity var(--duration-fast) var(--ease-out);
}
.action-btn:active {
  opacity: 0.7;
}
.action-btn.danger {
  color: var(--danger);
  background: var(--danger-tint);
}

/* CRM 统计卡（Standard 玻璃） */
.stats-card {
  display: flex;
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.stat-value.stat-time {
  font-size: 24rpx;
  color: var(--text-2);
  padding-top: 8rpx;
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 消费记录卡片：Dense 密集层 */
.order-card {
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft-1);
  border: 1rpx solid var(--glass-border);
  transition: transform var(--duration-fast) var(--ease-out);
}
.order-card:active {
  transform: scale(var(--scale-press));
}
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.order-no {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
}
.order-status {
  font-size: 22rpx;
}
.status-pending {
  color: var(--warning);
}
.status-paid {
  color: var(--success);
}
.status-done {
  color: var(--info);
}
.status-cancelled {
  color: var(--text-3);
}
.status-refunded {
  color: var(--danger);
}
.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-time {
  font-size: 22rpx;
  color: var(--text-3);
}
.order-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary);
}

/* 弹窗按钮：两按钮同高胶囊，取消略窄于确认 */
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* ===== 等级徽章 / CRM 档案（P2） ===== */
.profile-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.profile-name-row .profile-name {
  margin-bottom: 0;
}
.level-badge {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.7;
  font-weight: 600;
}
.level-normal {
  background: rgba(151, 160, 174, 0.14);
  color: var(--text-2);
}
.level-silver {
  background: linear-gradient(135deg, #f2f4f8 0%, #dde3ee 100%);
  color: #6b7688;
  border: 1rpx solid rgba(151, 160, 174, 0.3);
}
.level-gold {
  background: linear-gradient(135deg, #fdf0d5 0%, #f6d695 100%);
  color: #9a6b1f;
  border: 1rpx solid rgba(246, 214, 149, 0.6);
}
.level-diamond {
  background: linear-gradient(135deg, #e6e9ff 0%, #d3d8ff 100%);
  color: #5566cc;
  border: 1rpx solid rgba(123, 140, 247, 0.35);
}

.crm-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.crm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.crm-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
}
.crm-edit {
  font-size: 24rpx;
  color: var(--primary-dark);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-tint);
}
.crm-edit:active {
  opacity: 0.7;
}
.crm-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--hairline);
}
.crm-label {
  width: 90rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
  padding-top: 2rpx;
}
.crm-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}
.crm-text {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.6;
  word-break: break-all;
}
.crm-empty {
  font-size: 24rpx;
  color: var(--text-placeholder);
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.customer-tag {
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--primary-dark);
  background: var(--primary-tint);
}
.birthday-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: #b26a4a;
  background: rgba(242, 165, 124, 0.16);
}
.birthday-chip.today {
  color: #fff;
  background: linear-gradient(135deg, #f2a57c 0%, #ef8f66 100%);
  box-shadow: 0 4rpx 12rpx rgba(242, 165, 124, 0.35);
}
.birthday-chip .icon {
  font-size: 22rpx;
}

/* 快捷标签 / 备注短语（编辑弹窗） */
.chip-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.chip-option {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx dashed var(--glass-border);
  transition: all var(--duration-fast) var(--ease-out);
}
.chip-option.active {
  color: var(--primary-dark);
  background: var(--primary-tint);
  border: 1rpx solid var(--primary);
}
.chip-option:active {
  transform: scale(var(--scale-press));
}
.birthday-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.birthday-picker {
  flex: 1;
}
.picker-value {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-input);
  background: var(--bg-subtle);
  border: 1rpx solid var(--glass-border);
  font-size: 28rpx;
  color: var(--text-1);
}
.picker-value.ph {
  color: var(--text-placeholder);
}
.birthday-clear {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--danger);
  padding: 12rpx 8rpx;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-input);
  background: var(--bg-subtle);
  border: 1rpx solid var(--glass-border);
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 24rpx 0 36rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-motion: reduce) {
  .order-card,
  .action-btn {
    transition: none !important;
  }
  .order-card:active {
    transform: none;
  }
}
