/* 会员列表页样式（CSS 变量） */
.page { padding: 24rpx 24rpx 0; }

/* 页头 */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 6rpx 20rpx;
}
.list-title { font-size: 40rpx; font-weight: bold; color: var(--text-1); letter-spacing: 1rpx; }
.list-count { font-size: 24rpx; color: var(--text-2); }

/* 搜索栏（与商品页同风格） */
.search-bar { margin-bottom: 24rpx; }
.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  padding: 18rpx 28rpx;
  border: 1rpx solid var(--border-strong);
}
.search-icon { color: var(--text-3); font-size: 28rpx; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--text-1); }
.search-clear { color: var(--text-3); font-size: 34rpx; line-height: 1; padding: 0 10rpx; }
.ph { color: var(--text-placeholder); }

/* 会员卡片 */
.customer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border);
}
.customer-card:active { background: var(--bg-subtle); }
.customer-main { display: flex; align-items: center; flex: 1; min-width: 0; }
.customer-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(225, 72, 60, 0.25);
}
.customer-info { flex: 1; min-width: 0; }
.customer-name-row { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 10rpx; }
.customer-name { font-size: 30rpx; font-weight: bold; color: var(--text-1); }
.customer-phone { font-size: 24rpx; color: var(--text-2); letter-spacing: 1rpx; }
.customer-meta { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; }
.meta-item { font-size: 22rpx; color: var(--text-3); }
.customer-arrow { color: var(--text-placeholder); font-size: 28rpx; flex-shrink: 0; margin-left: 12rpx; }

/* 添加会员弹窗：性别二选一 */
.gender-options {
  display: flex;
  flex: 1;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.gender-options.inline {
  flex: 0 0 230rpx;
  margin-left: 20rpx;
}
.surname-input { flex: 1; min-width: 0; }
.gender-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-card);
}
.gender-option + .gender-option { border-left: 1rpx solid var(--border); }
.gender-option.active {
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}

/* 弹窗按钮：两按钮同高胶囊，取消略窄于确认 */
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* FAB 与加载提示（与商品页同风格） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #ffffff;
  font-size: 52rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: var(--shadow-primary);
  z-index: 10;
}
.fab .icon { font-size: 44rpx; }
.fab:active { opacity: 0.85; }
.loading-tip { text-align: center; padding: 24rpx 0 36rpx; font-size: 24rpx; color: var(--text-3); }
