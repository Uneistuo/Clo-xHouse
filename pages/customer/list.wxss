/* 会员列表页样式 */
.page { padding: 24rpx 24rpx 0; }

/* 搜索栏（与商品页同风格） */
.search-bar { margin-bottom: 24rpx; }
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.search-icon { color: #9aa0ac; font-size: 28rpx; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #14161a; }
.search-clear { color: #9aa0ac; font-size: 26rpx; padding: 0 8rpx; }
.ph { color: #b8bdc7; }

/* 会员卡片 */
.customer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.customer-card:active { background: #f8f9fb; }
.customer-main { display: flex; align-items: center; flex: 1; min-width: 0; }
.customer-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(225, 72, 60, 0.1);
  color: #e1483c;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.customer-info { flex: 1; min-width: 0; }
.customer-name-row { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 10rpx; }
.customer-name { font-size: 30rpx; font-weight: bold; color: #14161a; }
.customer-phone { font-size: 24rpx; color: #5b616e; letter-spacing: 1rpx; }
.customer-meta { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; }
.meta-item { font-size: 22rpx; color: #9aa0ac; }
.customer-arrow { color: #c9cdd4; font-size: 28rpx; flex-shrink: 0; margin-left: 12rpx; }

/* 添加会员弹窗：性别二选一 */
.gender-options { display: flex; gap: 20rpx; }
.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border: 1rpx solid #e6e8ec;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #5b616e;
  background: #ffffff;
}
.gender-option.active {
  border-color: #e1483c;
  background: rgba(225, 72, 60, 0.06);
  color: #e1483c;
}

/* FAB 与加载提示（与商品页同风格） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e1483c;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(225, 72, 60, 0.4);
  z-index: 10;
}
.fab:active { opacity: 0.85; }
.loading-tip { text-align: center; padding: 24rpx 0 36rpx; font-size: 24rpx; color: #9aa0ac; }
