/* 会员列表页样式（清透质感：Wash 搜索 + Dense 会员卡） */
.page {
  padding: 24rpx 24rpx 0;
}

/* 页头 */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}
.list-title {
  font-size: var(--font-h2);
  font-weight: bold;
  color: var(--text-1);
  letter-spacing: 1rpx;
}
.list-count {
  font-size: 24rpx;
  color: var(--text-2);
}

/* 搜索栏（Wash 玻璃） */
.search-bar {
  margin-bottom: 24rpx;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border-radius: var(--radius-pill);
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--glass-border);
}
.search-icon {
  color: var(--text-3);
  font-size: 28rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
}
.ph {
  color: var(--text-placeholder);
}

/* 会员卡片：Dense 密集层 */
.customer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-soft-1);
  border: 1rpx solid var(--glass-border);
  transition: transform var(--duration-fast) var(--ease-out);
}
.customer-card:active {
  transform: scale(var(--scale-press));
}
.customer-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.customer-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(123, 140, 247, 0.25);
}
.customer-info {
  flex: 1;
  min-width: 0;
}
.customer-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.customer-name {
  font-size: var(--font-h3);
  font-weight: bold;
  color: var(--text-1);
}
.customer-phone {
  font-size: 24rpx;
  color: var(--text-2);
  letter-spacing: 1rpx;
}

/* 会员等级徽章（P2 CRM：按累计金额派生） */
.level-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.7;
  font-weight: 600;
}
.level-normal {
  background: rgba(151, 160, 174, 0.14);
  color: var(--text-2);
}
.level-silver {
  background: linear-gradient(135deg, #f2f4f8 0%, #dde3ee 100%);
  color: #6b7688;
  border: 1rpx solid rgba(151, 160, 174, 0.3);
}
.level-gold {
  background: linear-gradient(135deg, #fdf0d5 0%, #f6d695 100%);
  color: #9a6b1f;
  border: 1rpx solid rgba(246, 214, 149, 0.6);
}
.level-diamond {
  background: linear-gradient(135deg, #e6e9ff 0%, #d3d8ff 100%);
  color: #5566cc;
  border: 1rpx solid rgba(123, 140, 247, 0.35);
}

/* 会员标签（CRM 标签） */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.customer-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--primary-dark);
  background: var(--primary-tint);
}

/* 生日提醒 / 备注摘要 */
.remark-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 8rpx;
}
.birthday-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: #b26a4a;
  background: rgba(242, 165, 124, 0.16);
}
.birthday-chip.today {
  color: #fff;
  background: linear-gradient(135deg, #f2a57c 0%, #ef8f66 100%);
  box-shadow: 0 4rpx 12rpx rgba(242, 165, 124, 0.35);
}
.birthday-chip .icon {
  font-size: 22rpx;
}
.remark-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.customer-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}
.meta-item {
  font-size: 22rpx;
  color: var(--text-3);
}
.customer-arrow {
  color: var(--text-placeholder);
  font-size: 28rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 添加会员弹窗：姓氏输入（性别选择器已提取到 app.wxss） */
.surname-input {
  flex: 1;
  min-width: 0;
}

/* 弹窗按钮：两按钮同高胶囊，取消略窄于确认 */
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* FAB 与加载提示（与商品页同风格） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(64rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #ffffff;
  font-size: 52rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: var(--shadow-primary);
  z-index: 10;
  transition: transform var(--duration-fast) var(--ease-out);
}
.fab .icon {
  font-size: 44rpx;
}
.fab:active {
  transform: scale(var(--scale-press));
}
.page-bottom-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0 36rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .search-input-wrap {
    background: #f4f6fa;
  }
}
@media (prefers-reduced-motion: reduce) {
  .customer-card,
  .fab {
    transition: none !important;
  }
  .customer-card:active,
  .fab:active {
    transform: none;
  }
}
