<!-- 会员详情：CRM 统计 + 编辑/删除 + 消费记录 -->
<view class="page">
  <!-- 骨架屏 -->
  <block wx:if="{{!loaded}}">
    <view class="skeleton" style="height: 240rpx; border-radius: 20rpx;"></view>
    <view class="skeleton" style="height: 160rpx; border-radius: 20rpx; margin-top: 24rpx;"></view>
  </block>

  <block wx:else>
    <!-- 会员信息卡 -->
    <view class="card profile-card">
      <view class="profile-top">
        <view class="profile-avatar">{{customer.displayName[0]}}</view>
        <view class="profile-info">
          <view class="profile-name-row">
            <view class="profile-name">{{customer.displayName}}</view>
            <view class="level-badge {{customer.level.cls}}">{{customer.level.name}}</view>
          </view>
          <view class="profile-phone">{{customer.phone}}</view>
        </view>
      </view>
      <view class="profile-actions">
        <view class="action-btn" bindtap="openEdit">编辑</view>
        <view class="action-btn danger" bindtap="onDelete">删除</view>
      </view>
    </view>

    <!-- 会员档案（CRM：标签 / 生日 / 备注） -->
    <view class="card crm-card">
      <view class="crm-head">
        <view class="crm-title">会员档案</view>
        <view class="crm-edit" bindtap="openEdit">补充资料</view>
      </view>
      <view class="crm-row">
        <view class="crm-label">标签</view>
        <view class="crm-value">
          <view class="tag-row" wx:if="{{customer.tags.length}}">
            <text class="customer-tag" wx:for="{{customer.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text wx:else class="crm-empty">未设置</text>
        </view>
      </view>
      <view class="crm-row">
        <view class="crm-label">生日</view>
        <view class="crm-value">
          <block wx:if="{{customer.birthday}}">
            <text class="crm-text">{{customer.birthdayText}}</text>
            <text class="birthday-chip {{customer.daysLeft === 0 ? 'today' : ''}}">
              <text class="icon icon-cake"></text>
              {{customer.daysLeft === 0 ? '今天生日' : customer.daysLeft + ' 天后生日'}}
            </text>
          </block>
          <text wx:else class="crm-empty">未设置（用于生日提醒）</text>
        </view>
      </view>
      <view class="crm-row">
        <view class="crm-label">备注</view>
        <view class="crm-value">
          <text class="{{customer.remark ? 'crm-text' : 'crm-empty'}}">{{customer.remark || '暂无备注'}}</text>
        </view>
      </view>
    </view>

    <!-- CRM 统计卡 -->
    <view class="card stats-card">
      <view class="stat-item">
        <view class="stat-value">{{customer.orderCount}}</view>
        <view class="stat-label">消费次数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">￥{{customer.totalAmount}}</view>
        <view class="stat-label">累计金额</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-time">{{customer.lastOrderAt || '—'}}</view>
        <view class="stat-label">最近到店</view>
      </view>
    </view>

    <!-- 消费记录 -->
    <view class="section-title">消费记录（{{orderTotal}}）</view>
    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goOrder">
      <view class="order-top">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-status status-{{item.status}}">{{statusText(item.status)}}</text>
      </view>
      <view class="order-bottom">
        <text class="order-time">{{item.createdAt}}</text>
        <text class="order-amount">￥{{item.totalAmount}}</text>
      </view>
    </view>

    <!-- 消费记录空状态 -->
    <view wx:if="{{orderLoaded && orders.length === 0}}" class="empty">
      <view class="empty-icon icon icon-package"></view>
      <view>该会员暂无消费记录</view>
    </view>
    <view class="loading-tip" wx:if="{{orders.length > 0}}">
      {{orderLoading ? '加载中...' : (orderHasMore ? '上拉加载更多' : '没有更多了')}}
    </view>
  </block>

  <view class="page-bottom-space"></view>
</view>

<!-- 编辑会员弹窗 -->
<view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit">
  <view class="modal" catchtap="noop">
    <view class="modal-title">编辑会员</view>
    <view class="modal-sub">{{customer.phone}}</view>

    <view class="form-item">
      <view class="form-label required">姓氏</view>
      <input class="form-input" placeholder="如：赵" value="{{editSurname}}"
             bindinput="onEditSurnameInput" placeholder-class="ph" maxlength="10" />
    </view>
    <view class="form-item">
      <view class="form-label required">性别</view>
      <view class="gender-options">
        <view class="gender-option {{editGender === 1 ? 'active' : ''}}" data-gender="1" bindtap="onEditGenderTap">先生</view>
        <view class="gender-option {{editGender === 2 ? 'active' : ''}}" data-gender="2" bindtap="onEditGenderTap">女士</view>
      </view>
    </view>

    <!-- CRM：标签（快捷点选 + 手输，用顿号/逗号分隔） -->
    <view class="form-item">
      <view class="form-label">标签（选填，最多 8 个）</view>
      <view class="chip-options">
        <view wx:for="{{tagPresets}}" wx:key="*this"
              class="chip-option {{editTags.indexOf(item) >= 0 ? 'active' : ''}}"
              data-tag="{{item}}" bindtap="onEditTagPreset">+ {{item}}</view>
      </view>
      <input class="form-input" placeholder="如：常客、高价值" value="{{editTags}}"
             bindinput="onEditTagsInput" placeholder-class="ph" maxlength="120" />
    </view>

    <!-- CRM：生日（用于生日提醒） -->
    <view class="form-item">
      <view class="form-label">生日（选填）</view>
      <view class="birthday-row">
        <picker class="birthday-picker" mode="date" value="{{editBirthday}}" start="1930-01-01" end="2020-12-31"
                bindchange="onEditBirthdayChange">
          <view class="picker-value {{editBirthday ? '' : 'ph'}}">{{editBirthday || '选择生日'}}</view>
        </picker>
        <view wx:if="{{editBirthday}}" class="birthday-clear" bindtap="clearEditBirthday">清除</view>
      </view>
    </view>

    <!-- CRM：备注（快捷短语 + 手输） -->
    <view class="form-item">
      <view class="form-label">备注（选填，最多 200 字）</view>
      <view class="chip-options">
        <view wx:for="{{remarkPresets}}" wx:key="*this"
              class="chip-option {{editRemark.indexOf(item) >= 0 ? 'active' : ''}}"
              data-text="{{item}}" bindtap="onRemarkPreset">+ {{item}}</view>
      </view>
      <textarea class="form-textarea" placeholder="记录偏好、到店习惯等" value="{{editRemark}}"
                bindinput="onEditRemarkInput" placeholder-class="ph" maxlength="200" auto-height />
    </view>

    <view class="modal-btns">
      <button class="btn-ghost modal-btn" bindtap="closeEdit">取消</button>
      <button class="btn-primary modal-btn primary {{saving ? 'btn-loading' : ''}}" bindtap="confirmEdit"
              disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
    </view>
  </view>
</view>
