<!-- 会员列表页：搜索 + 分页列表（每项含 CRM 统计：消费次数/累计金额/最近到店） -->
<view class="page glow-page">
  <!-- 页头 -->
  <view class="list-head">
    <view class="list-title">会员</view>
    <view class="list-count" wx:if="{{loaded}}">共 {{total}} 位</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <view class="icon icon-search search-icon"></view>
      <input class="search-input" placeholder="搜索手机号 / 姓氏" value="{{keyword}}"
             bindinput="onKeywordInput" confirm-type="search" placeholder-class="ph"
             aria-label="搜索手机号或姓氏" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword"
            aria-role="button" aria-label="清空搜索">×</view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="customer-card" wx:for="{{list}}" wx:key="id"
        data-id="{{item.id}}" bindtap="goDetail"
        aria-role="button"
        aria-label="会员 {{item.displayName}}，{{item.level.name}}，手机号 {{item.phone}}，消费 {{item.orderCount}} 次，累计 {{item.totalAmount}} 元">
    <view class="customer-main">
      <view class="customer-avatar">{{item.displayName[0]}}</view>
      <view class="customer-info">
        <view class="customer-name-row">
          <text class="customer-name">{{item.displayName}}</text>
          <text class="level-badge {{item.level.cls}}">{{item.level.name}}</text>
          <text class="customer-phone">{{item.phone}}</text>
        </view>
        <!-- 标签（CRM） -->
        <view class="tag-row" wx:if="{{item.tags.length}}">
          <text class="customer-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="customer-meta">
          <text class="meta-item">消费 {{item.orderCount}} 次</text>
          <text class="meta-item">累计 ￥{{item.totalAmount}}</text>
          <text class="meta-item" wx:if="{{item.lastOrderAt}}">最近 {{item.lastOrderAt}}</text>
        </view>
        <!-- 生日提醒 / 备注摘要 -->
        <view class="remark-line" wx:if="{{item.birthdaySoon || item.remark}}">
          <text class="birthday-chip {{item.birthdayToday ? 'today' : ''}}" wx:if="{{item.birthdaySoon}}">
            <text class="icon icon-cake"></text>
            {{item.birthdayToday ? '今天生日' : item.daysLeft + ' 天后生日'}} · {{item.birthdayText}}
          </text>
          <text class="remark-text" wx:if="{{item.remark}}">{{item.remark}}</text>
        </view>
      </view>
    </view>
    <view class="customer-arrow icon icon-chevron-right" aria-hidden="true"></view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{loaded && list.length === 0}}" class="empty">
    <view class="empty-icon icon icon-package"></view>
    <view>{{keyword ? '未找到相关会员' : '暂无会员，点右下角 + 新增'}}</view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-tip" wx:if="{{list.length > 0}}">
    {{loading ? '加载中...' : (hasMore ? '上拉加载更多' : '没有更多了')}}
  </view>

  <view class="page-bottom-space"></view>
</view>

<!-- 新增会员 FAB -->
<view class="fab" bindtap="openAdd" aria-role="button" aria-label="新增会员"><view class="icon icon-plus" aria-hidden="true"></view></view>

<!-- 添加会员弹窗 -->
<view wx:if="{{addVisible}}" class="mask" bindtap="closeAdd">
  <view class="modal" catchtap="noop">
    <view class="modal-title">添加会员</view>

    <view class="form-item">
      <view class="form-label required">手机号</view>
      <input class="form-input" type="number" placeholder="11 位手机号" value="{{formPhone}}"
             bindinput="onFormPhoneInput" placeholder-class="ph" maxlength="11" aria-label="会员手机号" />
    </view>
    <view class="form-item">
      <view class="form-label required">姓氏</view>
      <input class="form-input surname-input" placeholder="如：赵" value="{{formSurname}}"
             bindinput="onFormSurnameInput" placeholder-class="ph" maxlength="10" aria-label="会员姓氏" />
      <view class="gender-options inline">
        <view class="gender-option {{formGender === 1 ? 'active' : ''}}" data-gender="1" bindtap="onFormGenderTap"
              aria-role="radio" aria-label="先生">先生</view>
        <view class="gender-option {{formGender === 2 ? 'active' : ''}}" data-gender="2" bindtap="onFormGenderTap"
              aria-role="radio" aria-label="女士">女士</view>
      </view>
    </view>

    <view class="modal-btns">
      <button class="btn-ghost modal-btn" bindtap="closeAdd">取消</button>
      <button class="btn-primary modal-btn primary {{saving ? 'btn-loading' : ''}}" bindtap="confirmAdd"
              disabled="{{saving}}">{{saving ? '保存中…' : '确认添加'}}</button>
    </view>
  </view>
</view>
