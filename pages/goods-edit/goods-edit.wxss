/* 商品编辑页样式（优化版：CSS 变量） */

.img-list { flex: 1; display: flex; flex-wrap: wrap; }
.img-item { position: relative; margin-right: 16rpx; margin-bottom: 16rpx; }
.img-thumb { width: 140rpx; height: 140rpx; border-radius: 16rpx; background: var(--bg-subtle); border: 1rpx solid var(--border); }
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: var(--danger);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}
.img-add {
  width: 140rpx;
  height: 140rpx;
  line-height: 136rpx;
  text-align: center;
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  color: var(--text-2);
  font-size: 48rpx;
  box-sizing: border-box;
  background: var(--bg-subtle);
}

.cat-input-row { display: flex; align-items: center; }
.cat-input { flex: 1; }
.cat-add-btn { flex-shrink: 0; margin-left: 16rpx; }

.section-title.mt { margin-top: 36rpx; }

.tag-row { min-height: 20rpx; margin-bottom: 16rpx; }
.tag-edit { padding: 10rpx 20rpx; margin-bottom: 12rpx; font-size: 26rpx; }
.tag-input-row { display: flex; align-items: center; }
.tag-input {
  background: var(--bg-subtle);
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  margin-right: 20rpx;
  border: 1rpx solid var(--border);
}

.size-table {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--border);
  border-left: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}
.size-cell {
  width: 25%;
  box-sizing: border-box;
  border-right: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--bg-card);
}
.size-cell-active {
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}

.size-options { display: flex; flex-wrap: wrap; }
.size-opt {
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  padding: 12rpx 34rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--bg-card);
}
.size-opt-active {
  border-color: var(--primary-dark);
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}

.color-opt { display: flex; align-items: center; }
.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 1rpx solid rgba(20, 22, 26, 0.15);
  box-sizing: border-box;
}

.sku-block { margin-top: 8rpx; }
.sku-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--bg-subtle);
}
.sku-name { flex: 1; font-size: 27rpx; color: var(--text-1); }
.sku-sep { color: var(--text-2); }
.sku-input {
  width: 160rpx;
  text-align: center;
  background: var(--bg-subtle);
  border-radius: 10rpx;
  padding: 12rpx 10rpx;
  border: 1rpx solid var(--border);
}
.sku-total {
  font-size: 26rpx;
  color: var(--primary-dark);
  font-weight: bold;
  margin-top: 16rpx;
  text-align: right;
}

.submit-btn { margin: 40rpx 0 80rpx; font-size: 32rpx; }
