/* 订单详情页样式（CSS 变量） */
.status-card { text-align: center; padding: 44rpx 24rpx; }
.status-tag { font-size: 28rpx; padding: 8rpx 30rpx; }
.status-amount { font-size: 28rpx; color: var(--text-1); margin-top: 20rpx; }
.status-amount .price { font-size: 46rpx; }
.status-sub { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; }

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.item-info { flex: 1; overflow: hidden; margin-right: 20rpx; }
.item-name { font-size: 28rpx; color: var(--text-1); font-weight: 700; }
.item-spec { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.item-price { font-size: 24rpx; color: var(--text-2); margin-left: 12rpx; }
.item-amount { font-size: 28rpx; color: var(--primary-dark); font-weight: 700; }
.total-row {
  text-align: right;
  font-size: 28rpx;
  color: var(--text-1);
  padding-top: 22rpx;
}

.info-row { display: flex; padding: 16rpx 0; }
.info-label { width: 150rpx; font-size: 26rpx; color: var(--text-2); flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: var(--text-1); word-break: break-all; }

.action-card { display: flex; flex-wrap: wrap; }
.action-btn { width: 100%; margin: 12rpx 0; font-size: 28rpx; }
.action-btn::after { border: none; }
.action-none { width: 100%; text-align: center; color: var(--text-3); font-size: 26rpx; padding: 20rpx 0; }
