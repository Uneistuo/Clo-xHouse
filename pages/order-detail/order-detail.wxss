/* 订单详情页样式（清透质感：Standard 分区卡 + 主色金额强调） */

/* 状态卡（Hero 白玻璃质感由全局 .card 提供，这里强化金额） */
.status-card {
  text-align: center;
  padding: 44rpx 24rpx;
}
.status-tag {
  font-size: 28rpx;
  padding: 8rpx 30rpx;
}
.status-pending {
  background: var(--warning-tint);
  color: var(--warning);
}
.status-paid {
  background: var(--success-tint);
  color: var(--success);
}
.status-done {
  background: var(--info-tint);
  color: var(--info);
}
.status-cancelled {
  background: var(--bg-subtle);
  color: var(--text-3);
}
.status-refunded {
  background: var(--danger-tint);
  color: var(--danger);
}
.status-amount {
  font-size: 28rpx;
  color: var(--text-1);
  margin-top: 20rpx;
}
.status-amount .price {
  font-size: 46rpx;
  color: var(--primary);
  font-weight: 800;
  letter-spacing: 0.5rpx;
}
.status-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.item-info {
  flex: 1;
  overflow: hidden;
  margin-right: 20rpx;
}
.item-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 700;
}
.item-spec {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.item-price {
  font-size: 24rpx;
  color: var(--text-2);
  margin-left: 12rpx;
}
.item-amount {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
}
.total-row {
  text-align: right;
  font-size: 28rpx;
  color: var(--text-1);
  padding-top: 22rpx;
}
.total-row .price {
  font-size: 36rpx;
  font-weight: 800;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
}
.info-label {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
  word-break: break-all;
}

.action-card {
  display: flex;
  flex-wrap: wrap;
}
.action-btn {
  width: 100%;
  margin: 12rpx 0;
  font-size: 28rpx;
}
.action-btn::after {
  border: none;
}
.action-none {
  width: 100%;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  padding: 20rpx 0;
}

/* ===== 订单动态时间线 ===== */
.timeline-card .section-title {
  margin-bottom: 8rpx;
}
.timeline {
  padding: 8rpx 0;
}
.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}
.timeline-dot {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-3);
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  z-index: 1;
}
.timeline-dot.done {
  background: var(--success);
}
.timeline-item:not(:last-child) .timeline-dot::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 18rpx;
  width: 2rpx;
  height: calc(100% + 16rpx);
  background: var(--hairline);
}
.timeline-content {
  flex: 1;
}
.timeline-label {
  font-size: 26rpx;
  color: var(--text-1);
}
.timeline-item.is-pending .timeline-label {
  color: var(--text-3);
}
.timeline-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.timeline-item.is-done .timeline-time {
  color: var(--text-2);
}

/* 状态变化脉冲（克制：仅一次轻微缩放） */
@keyframes status-pulse {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.08);
  }
  100% {
    transform: scale(1);
  }
}
.status-tag.pulse {
  animation: status-pulse 600ms var(--ease-spring);
}

@media (prefers-reduced-motion: reduce) {
  .status-tag.pulse {
    animation: none;
  }
}
