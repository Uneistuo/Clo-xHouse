/* 订单详情页样式 */
.status-card { text-align: center; padding: 40rpx 24rpx; }
.status-tag { font-size: 28rpx; padding: 8rpx 30rpx; }
.status-amount { font-size: 28rpx; color: #14161a; margin-top: 20rpx; }
.status-amount .price { font-size: 44rpx; }
.status-sub { font-size: 24rpx; color: #5b616e; margin-top: 12rpx; }

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eceef1;
}
.item-info { flex: 1; overflow: hidden; margin-right: 20rpx; }
.item-name { font-size: 28rpx; color: #14161a; font-weight: bold; }
.item-spec { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.item-price { font-size: 24rpx; color: #5b616e; margin-left: 12rpx; }
.item-amount { font-size: 28rpx; color: #c5362c; font-weight: bold; }
.total-row {
  text-align: right;
  font-size: 28rpx;
  color: #14161a;
  padding-top: 20rpx;
}

.info-row { display: flex; padding: 16rpx 0; }
.info-label { width: 150rpx; font-size: 26rpx; color: #5b616e; flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: #14161a; word-break: break-all; }

.action-card { display: flex; flex-wrap: wrap; justify-content: space-around; }
.action-btn { width: 100%; margin: 12rpx 0; }
.action-none { text-align: center; color: #9aa0ac; font-size: 26rpx; padding: 20rpx 0; }
