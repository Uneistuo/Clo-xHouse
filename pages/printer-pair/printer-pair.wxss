/*
 * 打印机配对页样式（清透质感：Standard 状态/说明卡 + 渐变扫描按钮）
 */

.page {
  min-height: 100vh;
  background: transparent;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡（Standard 玻璃） */
.status-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 36rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
.status-card.status-connected {
  border-color: rgba(59, 174, 118, 0.35);
}
.status-card.status-disconnected {
  border-color: var(--glass-border);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.status-card.status-connected .status-title {
  color: var(--success);
}
.status-card.status-disconnected .status-title {
  color: var(--text-1);
}

.status-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  text-align: center;
}

.saved-device {
  font-size: 24rpx;
  color: var(--success);
  padding: 8rpx 16rpx;
  background: var(--success-tint);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-on {
  background: var(--success);
}
.dot-off {
  background: var(--text-3);
}

/* 按钮（作用域限定在 .actions 内，避免与全局 .btn-* 冲突） */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.actions .btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: var(--radius-pill);
  border: none;
  transition:
    transform var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}
.actions .btn::after {
  border: none;
}
.actions .btn:active {
  transform: scale(var(--scale-press));
}
.actions .btn-primary {
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}
.actions .btn-warn {
  background: var(--warning-tint);
  color: var(--warning);
}
@keyframes scan-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(214, 154, 60, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(214, 154, 60, 0);
  }
}
.actions .btn-warn.scanning {
  animation: scan-pulse 1.2s ease infinite;
}
.actions .btn-ghost {
  background: rgba(255, 255, 255, 0.55);
  color: var(--primary-dark);
  border: 1rpx solid var(--glass-border);
}
.actions .btn-danger {
  background: var(--danger-tint);
  color: var(--danger);
  border: none;
}

/* 离线提示 */
.offline-hint {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-card);
  background: rgba(214, 154, 60, 0.1);
  border: 1rpx dashed rgba(214, 154, 60, 0.45);
  font-size: 24rpx;
  color: var(--warning);
  line-height: 1.6;
}
.offline-hint .icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

/* 打印设置卡（模板 / 纸张宽度） */
.settings-card {
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-1);
}
.settings-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.settings-row {
  margin-bottom: 20rpx;
}
.settings-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}
.settings-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.setting-chip {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
  transition: all var(--duration-fast) var(--ease-out);
}
.setting-chip.active {
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-color: var(--primary);
  font-weight: 600;
}
.setting-chip:active {
  transform: scale(var(--scale-press));
}
.settings-tip {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 最近打印记录 */
.logs-card {
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-1);
}
.logs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.logs-head .settings-title {
  margin-bottom: 0;
}
.logs-clear {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 4rpx 16rpx;
}
.logs-clear:active {
  color: var(--danger);
}
.log-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.log-item:last-child {
  border-bottom: none;
}
.log-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.log-icon.ok {
  color: var(--success);
}
.log-icon.fail {
  color: var(--danger);
}
.log-main {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.log-meta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-3);
}
.logs-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 8rpx 0 28rpx;
}

/* 设备列表（Dense 密集层） */
.device-list {
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-1);
}
.device-list-title {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  border-bottom: 1rpx solid var(--hairline);
}
.device-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.device-item:last-child {
  border-bottom: none;
}
.device-item:active {
  background: var(--primary-tint);
}

.device-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.device-id {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.device-info {
  flex: 1;
}
.device-rssi {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}
.device-rssi.strong {
  color: var(--rssi-strong);
}
.device-rssi.normal {
  color: var(--rssi-normal);
}
.device-rssi.weak {
  color: var(--rssi-weak);
}
.device-arrow {
  color: var(--text-3);
  font-size: 36rpx;
  margin-left: 16rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.8;
}

/* 帮助（Standard 玻璃） */
.help {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-top: 32rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
.help-title {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 16rpx;
}
.help-step {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .status-card,
  .help {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .actions .btn-ghost {
    background: #f4f6fa;
  }
  .saved-device {
    background: #eaf7f0;
  }
  .actions .btn-warn {
    background: #fbf1e2;
  }
  .actions .btn-danger {
    background: #fdeeed;
  }
  .setting-chip {
    background: #f4f6fa;
  }
}
@media (prefers-reduced-motion: reduce) {
  .actions .btn {
    transition: none !important;
  }
  .actions .btn-warn.scanning {
    animation: none !important;
  }
  .actions .btn:active {
    transform: none;
  }
  .setting-chip {
    transition: none !important;
  }
  .setting-chip:active {
    transform: none;
  }
}
