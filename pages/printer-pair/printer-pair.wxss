/*
 * 打印机配对页样式
 */

.page {
  min-height: 100vh;
  background: #F3EFE7;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡 */
.status-card {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(126, 47, 47, 0.05);
}
.status-card.status-connected { border: 2rpx solid #7E9F7E; }
.status-card.status-disconnected { border: 2rpx solid #a89a8c; }

.status-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a2e26;
  margin-bottom: 8rpx;
}
.status-card.status-connected .status-title { color: #5b7e5b; }
.status-card.status-disconnected .status-title { color: #7E2F2F; }

.status-sub {
  font-size: 24rpx;
  color: #8a7d70;
  margin-bottom: 16rpx;
  text-align: center;
}

.saved-device {
  font-size: 24rpx;
  color: #5b7e5b;
  padding: 8rpx 16rpx;
  background: rgba(91, 126, 91, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-on { background: #5b7e5b; }
.dot-off { background: #a89a8c; }

/* 按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: #7E2F2F;
  color: #FFFDF8;
}
.btn-warn {
  background: #a89a8c;
  color: #FFFDF8;
}
.btn-ghost {
  background: transparent;
  color: #7E2F2F;
  border: 2rpx solid #7E2F2F;
}
.btn-danger {
  background: transparent;
  color: #a89a8c;
  border: 2rpx solid #a89a8c;
}

/* 设备列表 */
.device-list {
  background: #FFFDF8;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.section-title {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #8a7d70;
  border-bottom: 1rpx solid rgba(168, 154, 140, 0.2);
}
.device-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(168, 154, 140, 0.15);
}
.device-item:last-child { border-bottom: none; }
.device-item:active { background: rgba(126, 47, 47, 0.05); }

.device-name {
  flex: 1;
  font-size: 28rpx;
  color: #3a2e26;
}
.device-id {
  font-size: 20rpx;
  color: #a89a8c;
  margin-top: 4rpx;
}
.device-info { flex: 1; }
.device-rssi {
  font-size: 20rpx;
  color: #8a7d70;
  margin-top: 4rpx;
}
.device-arrow {
  color: #a89a8c;
  font-size: 36rpx;
  margin-left: 16rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  color: #8a7d70;
  line-height: 1.8;
}

/* 帮助 */
.help {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 32rpx;
}
.help-title {
  font-size: 26rpx;
  color: #3a2e26;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.help-step {
  font-size: 24rpx;
  color: #5b4f43;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
