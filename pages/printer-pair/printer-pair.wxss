/*
 * 打印机配对页样式（CSS 变量）
 */

.page {
  min-height: 100vh;
  background: var(--bg-app);
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡 */
.status-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 36rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-1);
}
.status-card.status-connected { border-color: var(--success); }
.status-card.status-disconnected { border-color: var(--border-strong); }

.status-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.status-card.status-connected .status-title { color: var(--success); }
.status-card.status-disconnected .status-title { color: var(--text-1); }

.status-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  text-align: center;
}

.saved-device {
  font-size: 24rpx;
  color: var(--success);
  padding: 8rpx 16rpx;
  background: var(--success-tint);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-on { background: var(--success); }
.dot-off { background: var(--text-3); }

/* 按钮（作用域限定在 .actions 内，避免与全局 .btn-* 冲突） */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.actions .btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: var(--radius-input);
  border: none;
}
.actions .btn::after { border: none; }
.actions .btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
}
.actions .btn-warn {
  background: var(--text-3);
  color: #ffffff;
}
.actions .btn-ghost {
  background: transparent;
  color: var(--primary-dark);
  border: 2rpx solid var(--primary);
}
.actions .btn-danger {
  background: transparent;
  color: var(--text-2);
  border: 2rpx solid var(--border-strong);
}

/* 设备列表 */
.device-list {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.device-list-title {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  border-bottom: 1rpx solid var(--divider);
}
.device-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--divider);
}
.device-item:last-child { border-bottom: none; }
.device-item:active { background: var(--primary-tint); }

.device-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.device-id {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.device-info { flex: 1; }
.device-rssi {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}
.device-arrow {
  color: var(--text-3);
  font-size: 36rpx;
  margin-left: 16rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.8;
}

/* 帮助 */
.help {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-top: 32rpx;
  border: 1rpx solid var(--border);
}
.help-title {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.help-step {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.8;
  margin-bottom: 8rpx;
}
