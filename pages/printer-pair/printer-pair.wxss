/*
 * 打印机配对页样式
 */

.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡 */
.status-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(225, 72, 60, 0.05);
}
.status-card.status-connected { border: 2rpx solid #16a34a; }
.status-card.status-disconnected { border: 2rpx solid #9aa0ac; }

.status-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #14161a;
  margin-bottom: 8rpx;
}
.status-card.status-connected .status-title { color: #16a34a; }
.status-card.status-disconnected .status-title { color: #e1483c; }

.status-sub {
  font-size: 24rpx;
  color: #5b616e;
  margin-bottom: 16rpx;
  text-align: center;
}

.saved-device {
  font-size: 24rpx;
  color: #16a34a;
  padding: 8rpx 16rpx;
  background: rgba(22, 163, 74, 0.1);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.dot-on { background: #16a34a; }
.dot-off { background: #9aa0ac; }

/* 按钮（作用域限定在 .actions 内，避免与全局 .btn-* 冲突） */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.actions .btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}
.actions .btn::after { border: none; }
.actions .btn-primary {
  background: #e1483c;
  color: #ffffff;
}
.actions .btn-warn {
  background: #9aa0ac;
  color: #ffffff;
}
.actions .btn-ghost {
  background: transparent;
  color: #e1483c;
  border: 2rpx solid #e1483c;
}
.actions .btn-danger {
  background: transparent;
  color: #9aa0ac;
  border: 2rpx solid #9aa0ac;
}

/* 设备列表 */
.device-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.device-list-title {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #5b616e;
  border-bottom: 1rpx solid rgba(20, 22, 26, 0.2);
}
.device-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(20, 22, 26, 0.15);
}
.device-item:last-child { border-bottom: none; }
.device-item:active { background: rgba(225, 72, 60, 0.05); }

.device-name {
  flex: 1;
  font-size: 28rpx;
  color: #14161a;
}
.device-id {
  font-size: 20rpx;
  color: #9aa0ac;
  margin-top: 4rpx;
}
.device-info { flex: 1; }
.device-rssi {
  font-size: 20rpx;
  color: #5b616e;
  margin-top: 4rpx;
}
.device-arrow {
  color: #9aa0ac;
  font-size: 36rpx;
  margin-left: 16rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  color: #5b616e;
  line-height: 1.8;
}

/* 帮助 */
.help {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 32rpx;
}
.help-title {
  font-size: 26rpx;
  color: #14161a;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.help-step {
  font-size: 24rpx;
  color: #5b616e;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
