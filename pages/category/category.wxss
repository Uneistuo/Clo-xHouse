/* 分类管理页样式（清透质感：Dense 分类行 + Overlay 底部新增栏） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.cat-scroll {
  flex: 1;
  /* 底部固定栏高度 + 安全区，避免列表最后一项被遮住 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 页面顶部：标题 + 右上角管理按钮 */
.cat-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 16rpx;
}
.cat-page-title {
  font-size: var(--font-h2);
  font-weight: bold;
  color: var(--text-1);
  letter-spacing: 1rpx;
}
.cat-manage-btn {
  color: #fff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  padding: 8rpx 32rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-soft-1);
  transition: transform var(--duration-fast) var(--ease-out);
}
.cat-manage-btn:active {
  transform: scale(var(--scale-press));
  opacity: 1;
}

/* 管理模式提示条 */
.manage-hint {
  margin: 0 0 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: var(--radius-input);
}

/* 新增分类行 */
.add-row {
  display: flex;
  align-items: center;
}

/* 固定在页面最底部的新增分类栏（Overlay 玻璃） */
.add-card-fixed {
  position: fixed;
  left: 0;
  right: 0;
  /* 分类页为非 TabBar 页面，无需避让悬浮 TabBar；底部安全区由内边距处理 */
  bottom: 0;
  z-index: 101;
  background: var(--bg-overlay);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-hero) var(--radius-hero) 0 0;
  box-shadow: var(--shadow-float);
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  margin: 0;
  box-sizing: border-box;
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
.add-input {
  flex: 1;
  background: var(--bg-subtle);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-input);
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text-1);
  margin-right: 16rpx;
}

/* 分类卡片行：Dense 密集层（统一固定高度，便于长按拖动时位移计算） */
.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  position: relative;
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--glass-border);
  will-change: transform;
}
.cat-info {
  flex: 1;
  min-width: 0;
}
.cat-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-meta {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.cat-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
/* 空状态使用全局 .empty / .empty-icon */

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .add-card-fixed {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .add-input {
    background: #f4f6fa;
  }
}
@media (prefers-reduced-motion: reduce) {
  .cat-manage-btn {
    transition: none !important;
  }
  .cat-manage-btn:active {
    transform: none;
  }
}
