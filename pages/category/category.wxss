/* 分类管理页样式（CSS 变量） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.cat-scroll {
  flex: 1;
  /* 底部固定栏高度 + 安全区，避免列表最后一项被遮住 */
  padding-bottom: 180rpx;
  box-sizing: border-box;
}
/* 页面顶部：标题 + 右上角管理按钮 */
.cat-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 12rpx;
}
.cat-page-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-1);
  letter-spacing: 1rpx;
}
.cat-manage-btn {
  background: var(--primary);
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.cat-manage-btn:active { opacity: 0.85; }

/* 管理模式提示条 */
.manage-hint {
  margin: 0 0 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: 12rpx;
}

/* 新增分类行 */
.add-row { display: flex; align-items: center; }

/* 固定在页面最底部的新增分类栏（仅在有分类时显示） */
.add-card-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 18rpx rgba(20, 22, 26, 0.06);
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  margin: 0;
  box-sizing: border-box;
}
.add-input {
  flex: 1;
  background: var(--bg-subtle);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-input);
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-1);
  margin-right: 16rpx;
}

/* 分类卡片行（统一固定高度，便于长按拖动时位移计算） */
.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  position: relative;
  will-change: transform;
}
.cat-info { flex: 1; min-width: 0; }
.cat-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-meta { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; }
.cat-actions { display: flex; align-items: center; flex-shrink: 0; }
/* 空状态使用全局 .empty / .empty-icon */
