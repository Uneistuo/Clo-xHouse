<!--商品管理页：搜索 + 筛选 + 列表 + 批量管理 + 低库存预警（优化版：dialog.confirm + 按钮加载态 + CSS 变量）-->
<view class="page glow-page {{manageMode ? 'manage-open' : ''}}">
  <!-- 搜索栏 + 分类/管理入口（分类为图标按钮，置于行首） -->
  <view class="search-bar">
    <view class="category-entry" bindtap="goCategory">
      <view class="icon icon-folder"></view>
    </view>
    <view class="search-input-wrap">
      <view class="icon icon-search search-icon"></view>
      <input class="search-input" placeholder="搜索商品名称" value="{{keyword}}"
             bindinput="onKeywordInput" bindconfirm="handleSearch" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">×</view>
    </view>
    <view class="bar-actions">
      <view class="manage-entry {{manageMode ? 'active' : ''}}" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</view>
    </view>
  </view>

  <!-- 上架状态筛选 -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key"
          class="tab {{statusTab === item.key ? 'tab-active' : ''}}"
          data-key="{{item.key}}" bindtap="switchTab">{{item.text}}</view>
  </view>

  <!-- 骨架屏（首次加载，统一使用 skeleton-card 组件） -->
  <block wx:if="{{loading && !loaded}}">
    <view wx:for="{{[1,2]}}" wx:key="*this" class="list-card goods-card">
      <view class="goods-main">
        <skeleton-card
          avatar="{{true}}"
          avatar-size="{{160}}"
          rows="{{3}}"
          heights="30,24,24"
          widths="60%,40%,85%"
          gap="{{20}}"
        />
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-state-icon icon icon-package"></view>
    <view class="empty-state-title">{{keyword ? '未搜索到相关商品' : '暂无商品，点击右下角 + 新增'}}</view>
  </view>

  <!-- 商品列表 -->
  <block wx:else>
    <view wx:for="{{list}}" wx:key="id"
          class="list-card goods-card {{item.selected ? 'goods-selected' : ''}}"
          data-id="{{item.id}}" bindtap="onCardTap">
      <view class="goods-main">
        <view wx:if="{{manageMode}}" class="select-dot {{item.selected ? 'on' : ''}}"></view>
        <!-- P1-4：图片懒加载，加载失败/无图时展示占位图 -->
        <image wx:if="{{item.cover}}" class="goods-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"
               binderror="onCoverError" data-index="{{index}}" />
        <view wx:else class="goods-img img-placeholder"><view class="icon icon-package"></view></view>
        <view class="goods-info">
          <view class="goods-name ellipsis">{{item.name}}</view>
          <view wx:if="{{item.goods_no}}" class="goods-no ellipsis">货号：{{item.goods_no}}</view>
          <view class="goods-price">
            <text class="price">￥{{item.priceText}}</text>
            <text wx:if="{{item.original_price > 0}}" class="origin-price">￥{{item.originalPriceText}}</text>
          </view>
          <view class="goods-meta">
            <text class="{{item.stock === 0 ? 'stock-zero' : (item.stockWarn ? 'stock-low' : '')}}">库存 {{item.stock}}</text>
            <text wx:if="{{item.stockWarn}}" class="tag tag-red">低库存</text>
            <text wx:if="{{item.category_name}}" class="tag tag-blue">{{item.category_name}}</text>
          </view>
          <view class="tag {{item.on_sale === 1 ? 'tag-green' : 'tag-gray'}}">
            {{item.on_sale === 1 ? '上架中' : '已下架'}}
          </view>
        </view>
      </view>
      <view class="goods-actions" wx:if="{{!manageMode}}">
        <view class="btn-ghost btn-mini" data-id="{{item.id}}" bindtap="goEdit">编辑</view>
        <view class="btn-ghost btn-mini {{loadingDelete === item.id ? 'btn-loading' : ''}}"
              data-id="{{item.id}}" data-onsale="{{item.on_sale}}" bindtap="toggleStatus">
          {{item.on_sale === 1 ? '下架' : '上架'}}
        </view>
        <view class="btn-danger btn-mini {{loadingDelete === item.id ? 'btn-loading' : ''}}"
              data-id="{{item.id}}" data-name="{{item.name}}" bindtap="handleDelete">删除</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:elif="{{hasMore && list.length > 0}}" class="loading-tip">上拉加载更多</view>
  </block>

  <!-- 新增商品悬浮按钮 -->
  <view wx:if="{{!manageMode}}" class="fab fab-goods" bindtap="goAdd">
    <view class="icon icon-plus"></view>
    <view class="fab-label">新商品</view>
  </view>

  <!-- 批量操作栏 -->
  <view wx:if="{{manageMode}}" class="batch-bar">
    <view class="batch-all" bindtap="toggleSelectAll">
      <view class="select-dot {{allSelected ? 'on' : ''}}"></view>
      <text>全选</text>
    </view>
    <view class="batch-actions">
      <view class="btn-ghost btn-mini {{loadingBatch ? 'btn-loading' : ''}}" data-onsale="1" bindtap="batchOnSale">上架</view>
      <view class="btn-ghost btn-mini {{loadingBatch ? 'btn-loading' : ''}}" data-onsale="0" bindtap="batchOnSale">下架</view>
      <view class="btn-danger btn-mini {{loadingBatch ? 'btn-loading' : ''}}" bindtap="batchDelete">删除</view>
    </view>
  </view>
</view>
