/* 商品管理页样式（优化版：CSS 变量） */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--border-strong);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: var(--text-2);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

/* 分类入口：纯图标按钮（三条横杠），无底框，位于搜索栏行首 */
.category-entry {
  flex-shrink: 0;
  margin-right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-size: 40rpx;
}
.category-entry:active {
  opacity: 0.5;
}

.tabs {
  display: flex;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.goods-no {
  font-size: 23rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 16rpx 0;
  border-radius: 999rpx;
}
.tab-active {
  color: #ffffff;
  background: var(--primary);
  font-weight: bold;
}

.goods-card {
  padding: 20rpx;
}
.goods-main {
  display: flex;
}
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
  border: 1rpx solid var(--border);
}
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
/* P1-4：图片加载失败/无图占位 */
.img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
}
.img-placeholder .icon {
  font-size: 56rpx;
}
.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.goods-price {
  margin: 10rpx 0;
  font-size: 32rpx;
}
.origin-price {
  color: var(--text-2);
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}
.goods-meta {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}
.goods-meta text:first-child {
  margin-right: 12rpx;
}
.goods-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.loading-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 20rpx 0 160rpx;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 56rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-primary);
}

/* 搜索栏右侧入口 */
.bar-actions {
  display: flex;
  align-items: center;
}
.manage-entry {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  border: 1rpx solid var(--border);
}
.manage-entry.active {
  color: #fff;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
}

/* 低库存预警 */
.stock-warn {
  color: var(--danger);
  font-weight: 700;
}

/* 批量选择圆点 */
.select-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  box-sizing: border-box;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.select-dot.on {
  background: var(--primary);
  border-color: var(--primary);
  position: relative;
}
.select-dot.on::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.goods-selected {
  border: 1.5rpx solid var(--primary);
}

/* 批量操作栏 */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 18rpx rgba(20, 22, 26, 0.08);
  border-top: 1rpx solid var(--border);
}
.batch-all {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-1);
}
.batch-all .select-dot {
  margin-right: 12rpx;
}
.batch-actions {
  display: flex;
  align-items: center;
}
.batch-actions .btn-mini {
  margin-left: 16rpx;
}

/* 适配自定义 TabBar */
.page {
  padding-bottom: 180rpx;
}
.fab {
  bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.batch-bar {
  bottom: calc(100rpx + env(safe-area-inset-bottom));
}
