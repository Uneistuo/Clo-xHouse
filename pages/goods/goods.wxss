/* 商品管理页样式（清透质感：Wash 搜索/分段 + Dense 商品行 + 玻璃批量栏） */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--glass-border);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 16rpx;
  color: var(--text-3);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
}

/* 分类入口：纯图标按钮（三条横杠），无底框，位于搜索栏行首 */
.category-entry {
  flex-shrink: 0;
  margin-right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-size: 40rpx;
}
.category-entry:active {
  opacity: 0.5;
}

/* 分段控件：Wash 层轨道 + 白色胶囊滑块 */
.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
}
.goods-no {
  font-size: var(--font-xs);
  color: var(--text-2);
  margin-top: 4rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 16rpx 0;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}
.tab-active {
  color: var(--primary-dark);
  background: rgba(255, 255, 255, 0.92);
  font-weight: bold;
  box-shadow: var(--shadow-soft-1);
}

/* 商品行：Dense 密集层（不模糊，长列表性能优先） */
.goods-card {
  padding: 24rpx;
}
.goods-main {
  display: flex;
}
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  flex-shrink: 0;
  border: 1rpx solid var(--glass-border);
}
.goods-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}
/* P1-4：图片加载失败/无图占位 */
.img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  border: 1rpx solid var(--glass-border);
}
.img-placeholder .icon {
  font-size: 56rpx;
  opacity: 0.6;
}
.goods-name {
  font-size: var(--font-h3);
  font-weight: bold;
  color: var(--text-1);
}
.goods-price {
  margin: 8rpx 0;
  font-size: 32rpx;
}
.origin-price {
  color: var(--text-2);
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.goods-meta {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}
.goods-meta text:first-child {
  margin-right: 16rpx;
}
.goods-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.loading-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 20rpx 0 160rpx;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 56rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-primary);
  transition: transform var(--duration-fast) var(--ease-out);
}
.fab:active {
  transform: scale(var(--scale-press));
}
.fab-label {
  position: absolute;
  left: 50%;
  bottom: -32rpx;
  transform: translateX(-50%);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--primary-dark);
  white-space: nowrap;
}

/* 搜索栏右侧入口 */
.bar-actions {
  display: flex;
  align-items: center;
}
.manage-entry {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  transition: opacity var(--duration-fast) var(--ease-out);
}
.manage-entry.active {
  color: #fff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-color: transparent;
}
.manage-entry:active {
  opacity: 0.85;
}

/* 库存风险分级的颜色由 app.wxss 的 .stock-zero / .stock-low 统一提供 */

/* 批量选择圆点 */
.select-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  box-sizing: border-box;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.select-dot.on {
  background: var(--primary);
  border-color: var(--primary);
  position: relative;
}
.select-dot.on::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 10rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.goods-selected {
  border: 1rpx solid var(--primary);
  box-shadow: var(--shadow-soft-2), var(--inner-light);
}

/* 批量操作栏：与悬浮 TabBar 无缝拼接为同一块 Overlay 面板 */
.batch-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  /* 向上叠 1rpx 盖住 TabBar 顶边，避免拼接处出现发丝缝 */
  bottom: calc(var(--space-tabbar-bottom, 124rpx) - 1rpx + env(safe-area-inset-bottom));
  z-index: 101; /* 高于 TabBar(100) */
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  /* 与开单页结算栏等高，避免两页来回切换时面板高度跳变 */
  min-height: var(--dock-bar-height, 136rpx);
  background: var(--bg-overlay);
  padding: 24rpx 32rpx;
  border: 1rpx solid var(--glass-border);
  border-bottom: none;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-shadow:
    0 -14rpx 40rpx rgba(35, 45, 75, 0.08),
    var(--inner-light);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
  /* 从 TabBar 后方滑出，替代原先的瞬间出现 */
  animation: dock-bar-in 0.26s cubic-bezier(0.4, 0, 0.2, 1) both;
}
@keyframes dock-bar-in {
  from {
    transform: translateY(16rpx);
  }
  to {
    transform: translateY(0);
  }
}
.batch-all {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-1);
}
.batch-all .select-dot {
  margin-right: 16rpx;
}
.batch-actions {
  display: flex;
  align-items: center;
}
.batch-actions .btn-mini {
  margin-left: 16rpx;
}

/* 适配悬浮玻璃 TabBar（108rpx 栏高 + 16rpx 间距 + 安全区） */
.page {
  padding-bottom: calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + 96rpx);
}
/* 批量态：底部让出与结算栏等高的批量栏，避免最后一张卡被遮挡 */
.page.manage-open {
  padding-bottom: calc(
    var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + var(--dock-bar-height, 136rpx)
  );
}
.fab-goods {
  bottom: calc(var(--space-fab-bottom, 160rpx) + env(safe-area-inset-bottom));
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .search-input-wrap,
  .tabs,
  .manage-entry {
    background: #f4f6fa;
  }
  .tab-active {
    background: #ffffff;
  }
  .batch-bar {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .tab,
  .fab,
  .manage-entry {
    transition: none !important;
  }
  .fab:active {
    transform: none;
  }
}
