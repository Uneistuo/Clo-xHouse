/* 商品管理页样式 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.category-entry {
  margin-left: 20rpx;
  color: #c5362c;
  font-size: 28rpx;
  padding: 12rpx 8rpx;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.goods-no { font-size: 23rpx; color: #9aa0ac; margin-top: 4rpx; }

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #5b616e;
  padding: 16rpx 0;
  border-radius: 999rpx;
}
.tab-active {
  color: #ffffff;
  background: #e1483c;
  font-weight: bold;
}

.goods-card { padding: 20rpx; }
.goods-main { display: flex; }
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f0f1f4;
  flex-shrink: 0;
}
.goods-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.goods-name { font-size: 30rpx; font-weight: bold; color: #14161a; }
.goods-price { margin: 10rpx 0; font-size: 32rpx; }
.origin-price {
  color: #9aa0ac;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}
.goods-meta {
  font-size: 24rpx;
  color: #5b616e;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}
.goods-meta text:first-child { margin-right: 12rpx; }
.goods-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eceef1;
}
.goods-actions .btn-mini:first-child { margin-left: 0; }

.loading-tip {
  text-align: center;
  color: #9aa0ac;
  font-size: 24rpx;
  padding: 20rpx 0 160rpx;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
  color: #fff;
  font-size: 56rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(225, 72, 60, 0.32);
}

/* ===== 搜索栏右侧入口（分类 / 管理） ===== */
.bar-actions { display: flex; align-items: center; }
.manage-entry {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #5b616e;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.manage-entry.active {
  color: #fff;
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
}

/* ===== 低库存预警 ===== */
.stock-warn { color: #dc2626; font-weight: 600; }

/* ===== 批量选择圆点 ===== */
.select-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d3d7de;
  box-sizing: border-box;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.select-dot.on { background: #e1483c; border-color: #e1483c; position: relative; }
.select-dot.on::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.goods-selected { border: 1.5rpx solid #e1483c; }

/* ===== 批量操作栏 ===== */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 18rpx rgba(20, 22, 26, 0.08);
}
.batch-all { display: flex; align-items: center; font-size: 28rpx; color: #14161a; }
.batch-all .select-dot { margin-right: 12rpx; }
.batch-actions { display: flex; align-items: center; }
.batch-actions .btn-mini { margin-left: 16rpx; }
/* ===== 适配自定义 TabBar（底部悬浮，内容留白 / 固定元素上移） ===== */
.page { padding-bottom: 180rpx; }
.fab { bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.batch-bar { bottom: calc(100rpx + env(safe-area-inset-bottom)); }