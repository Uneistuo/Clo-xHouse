/* 商品管理页样式（清透质感：Wash 搜索/分段 + Dense 商品行 + 玻璃批量栏） */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--glass-border);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 16rpx;
  color: var(--text-3);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
}

/* 分类入口：纯图标按钮（三条横杠），无底框，位于搜索栏行首 */
.category-entry {
  flex-shrink: 0;
  margin-right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  font-size: 40rpx;
}
.category-entry:active {
  opacity: 0.5;
}

/* 分段控件：Wash 层轨道 + 白色胶囊滑块 */
.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--glass-border);
}
.goods-no {
  font-size: var(--font-xs);
  color: var(--text-2);
  margin-top: 4rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 16rpx 0;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}
.tab-active {
  color: var(--primary-dark);
  background: rgba(255, 255, 255, 0.92);
  font-weight: bold;
  box-shadow: var(--shadow-soft-1);
}

/* 商品行：Dense 密集层（不模糊，长列表性能优先） */
.goods-card {
  padding: 24rpx;
}
.goods-main {
  display: flex;
}
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  flex-shrink: 0;
  border: 1rpx solid var(--glass-border);
}
.goods-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}
/* P1-4：图片加载失败/无图占位 */
.img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  border: 1rpx solid var(--glass-border);
}
.img-placeholder .icon {
  font-size: 56rpx;
  opacity: 0.6;
}
.goods-name {
  font-size: var(--font-h3);
  font-weight: bold;
  color: var(--text-1);
}
/* 头部一行：左标题（商品名 + 货号），右价格（售价 / 原价两行） */
.goods-head {
  display: flex;
  align-items: flex-start;
}
.goods-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.goods-price {
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
}
.price {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
}
.origin-price {
  display: block;
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 1.25;
  margin-top: 6rpx;
  text-decoration: line-through;
}
.goods-meta {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}
/* 上架状态灯：绿灯=上架中，红灯=已下架 */
.status-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.status-dot-on {
  background: var(--success);
  box-shadow: 0 0 0 4rpx var(--success-tint);
}
.status-dot-off {
  background: var(--danger);
  box-shadow: 0 0 0 4rpx var(--danger-tint);
}
.goods-meta text:first-child {
  margin-right: 16rpx;
}

.loading-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 20rpx 0 160rpx;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 56rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-primary);
  transition: transform var(--duration-fast) var(--ease-out);
}
.fab:active {
  transform: scale(var(--scale-press));
}
.fab-label {
  position: absolute;
  left: 50%;
  bottom: -32rpx;
  transform: translateX(-50%);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--primary-dark);
  white-space: nowrap;
}

/* 搜索栏右侧入口 */
.bar-actions {
  display: flex;
  align-items: center;
}
.manage-entry {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  transition: opacity var(--duration-fast) var(--ease-out);
}
.manage-entry.active {
  color: #fff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-color: transparent;
}
.manage-entry:active {
  opacity: 0.85;
}

/* 库存风险分级的颜色由 app.wxss 的 .stock-zero / .stock-low 统一提供 */

/* 批量选择圆点 */
.select-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  box-sizing: border-box;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.select-dot.on {
  background: var(--primary);
  border-color: var(--primary);
  position: relative;
}
.select-dot.on::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 10rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.goods-selected {
  border: 1rpx solid var(--primary);
  box-shadow: var(--shadow-soft-2), var(--inner-light);
}

/* 批量操作栏：与悬浮 TabBar 无缝拼接为同一块 Overlay 面板 */
.batch-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  /* 向上叠 1rpx 盖住 TabBar 顶边，避免拼接处出现发丝缝 */
  bottom: calc(var(--space-tabbar-bottom, 124rpx) - 1rpx + env(safe-area-inset-bottom));
  z-index: 101; /* 高于 TabBar(100) */
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  /* 与开单页结算栏等高，避免两页来回切换时面板高度跳变 */
  min-height: var(--dock-bar-height, 136rpx);
  /* 不透明度提高一点替代毛玻璃：固定层做 backdrop-filter 后，
     滚动和位移时每帧都要重新采样背景，是这块最贵的地方。
     底色与拼接态 TabBar 共用 --dock-bg，接缝处不能有色差。 */
  background: var(--dock-bg, rgba(255, 255, 255, 0.94));
  padding: 24rpx 32rpx;
  border: 1rpx solid var(--glass-border);
  border-bottom: none;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-shadow:
    0 -14rpx 40rpx rgba(35, 45, 75, 0.08),
    var(--inner-light);
}
/* ===== 拼接态入场：批量栏从 TabBar 后方「拉出」 =====
   只在「普通栏 → 拼接栏」那一次挂上类名（见 _pullBatchBar），
   静止时没有任何动画；只动 transform / opacity，投影不逐帧重画。 */
.batch-bar.batch-pulling {
  z-index: 99;
  will-change: transform, opacity;
  animation: dock-card-pull 0.36s cubic-bezier(0.32, 0.72, 0, 1) both;
}
/* 页面被隐藏期间先藏住批量栏（见 onHide），缓存页重新显示的第一帧
   不会先画出「上一次的静止态」，拉出动画因此只播一次。 */
.batch-bar.batch-hidden {
  opacity: 0;
}
@keyframes dock-card-pull {
  from {
    transform: translateY(calc(100% + var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom)));
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.batch-all {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-1);
}
.batch-all .select-dot {
  margin-right: 16rpx;
}
.batch-actions {
  display: flex;
  align-items: center;
}
.batch-actions .btn-mini {
  margin-left: 16rpx;
}

/* 适配悬浮玻璃 TabBar（108rpx 栏高 + 16rpx 间距 + 安全区） */
.page {
  padding-bottom: calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + 96rpx);
}
/* 批量态：底部让出与结算栏等高的批量栏，避免最后一张卡被遮挡 */
.page.manage-open {
  padding-bottom: calc(
    var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + var(--dock-bar-height, 136rpx)
  );
}
.fab-goods {
  bottom: calc(var(--space-fab-bottom, 160rpx) + env(safe-area-inset-bottom));
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .search-input-wrap,
  .tabs,
  .manage-entry {
    background: #f4f6fa;
  }
  .tab-active {
    background: #ffffff;
  }
  .batch-bar {
    background: #ffffff;
  }
}
@media (prefers-reduced-motion: reduce) {
  .tab,
  .fab,
  .manage-entry {
    transition: none !important;
  }
  .fab:active {
    transform: none;
  }
  /* 批量栏拉出动画一并关闭，直接落位 */
  .batch-bar.batch-pulling {
    animation: none !important;
  }
}
