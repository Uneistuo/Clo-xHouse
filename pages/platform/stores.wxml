<!--平台管理页：店铺开单白名单时效控制-->
<view class="platform-page glow-page">
  <view class="plat-head">
    <view class="plat-title">平台管理</view>
    <view class="plat-sub">控制各店铺"开单"功能的授权时效；到期或关闭后店铺立即无法现场开单，商品与订单数据不受限制</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && list.length === 0}}" class="plat-tip">加载中...</view>

  <!-- 店铺列表 -->
  <view wx:for="{{list}}" wx:key="id" class="store-row" aria-label="店铺 {{item.name}}，店主 {{item.owner_name || '未知'}}，{{item.enabled ? '可开单' : '未授权开单'}}">
    <view class="store-main">
      <view class="store-nm ellipsis">{{item.name}}</view>
      <view class="store-meta">店主 {{item.owner_name || '-'}} · 成员 {{item.member_count}} · 订单 {{item.order_count}}</view>
      <view class="store-meta">店铺码 {{item.bind_code}} · {{item.created_at}}</view>
      <view wx:if="{{item.enabled}}" class="store-bill on">
        可开单 · 授权至 {{item.expireAt}}（剩 {{item.daysLeft}} 天）
      </view>
      <view wx:elif="{{item.expireAt}}" class="store-bill expired">授权已到期 · {{item.expireAt}}</view>
      <view wx:else class="store-bill off">未授权开单</view>
    </view>
    <view class="store-ctrl">
      <view class="ctrl-btn primary" data-index="{{index}}" bindtap="openAuth"
            aria-role="button" aria-label="{{item.enabled ? '续期' : '授权'}}店铺 {{item.name}}">{{item.enabled ? '续期' : '授权'}}</view>
      <view wx:if="{{item.expireAt}}" class="ctrl-btn ghost" data-id="{{item.id}}" data-name="{{item.name}}"
            bindtap="onCloseAuth" aria-role="button" aria-label="关闭店铺 {{item.name}} 的开单授权">关闭</view>
      <view class="ctrl-btn ghost"
            data-id="{{item.id}}" data-name="{{item.name}}"
            bindtap="onRenameStore" aria-role="button" aria-label="重命名店铺 {{item.name}}">改名</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && list.length === 0}}" class="plat-tip">暂无店铺</view>

  <view class="page-bottom-space"></view>

  <!-- 授权 / 续期弹层 -->
  <view wx:if="{{visible}}" class="mask" bindtap="closeAuth">
    <view class="modal" catchtap="noop">
      <view class="modal-title">开单授权 · {{store.name}}</view>
      <view class="modal-sub" wx:if="{{store.expireAt}}">当前授权至 {{store.expireAt}}</view>

      <view class="opt-label">按天数授权（自当前时间起算）</view>
      <view class="opt-row">
        <view wx:for="{{quickDays}}" wx:key="*this"
              class="opt-item {{selDays === item ? 'opt-active' : ''}}"
              data-days="{{item}}" bindtap="pickDays"
              aria-role="button" aria-label="授权 {{item}} 天">{{item}} 天</view>
      </view>

      <view class="opt-label">自定义天数</view>
      <input class="opt-input" type="number" placeholder="输入天数（如 15）" value="{{customDays}}"
             bindinput="onCustomDays" placeholder-class="ph" aria-label="自定义授权天数" />

      <view class="opt-label">或指定到期日期</view>
      <picker mode="date" value="{{dateValue}}" bindchange="onDateChange" aria-label="选择授权到期日期">
        <view class="opt-item picker {{dateValue ? 'opt-active' : ''}}">
          {{dateValue ? dateValue + '（当日 23:59:59 到期）' : '选择到期日期'}}
        </view>
      </picker>

      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeAuth" aria-label="取消授权设置">取消</button>
        <button class="btn-primary modal-btn primary {{submitting ? 'btn-loading' : ''}}" bindtap="confirmAuth"
                disabled="{{submitting}}" aria-label="{{submitting ? '提交中' : '确认授权'}}">{{submitting ? '提交中…' : '确认授权'}}</button>
      </view>
    </view>
  </view>
</view>
