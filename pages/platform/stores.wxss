/* 平台管理页：米色底 + 酒红主调 */
.platform-page {
  background: #f4f5f7;
  min-height: 100vh;
  padding: 24rpx 30rpx 0;
  box-sizing: border-box;
}

.plat-head { padding: 10rpx 6rpx 24rpx; }
.plat-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #14161a;
  letter-spacing: 2rpx;
}
.plat-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5b616e;
  line-height: 1.6;
}

.plat-tip {
  text-align: center;
  color: #5b616e;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.page-bottom-space { height: 40rpx; }

/* 店铺行 */
.store-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.store-main { flex: 1; min-width: 0; }
.store-nm {
  font-size: 32rpx;
  font-weight: bold;
  color: #14161a;
}
.store-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5b616e;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 授权状态标签 */
.store-bill {
  margin-top: 12rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  display: inline-block;
}
.store-bill.on {
  color: #e1483c;
  background: #fdecea;
  font-weight: bold;
}
.store-bill.expired { color: #dc2626; background: #fdecea; }
.store-bill.off { color: #9aa0ac; background: #eef0f3; }

/* 操作按钮区 */
.store-ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}
.ctrl-btn {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
  text-align: center;
}
.ctrl-btn + .ctrl-btn { margin-top: 14rpx; }
.ctrl-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
  box-shadow: 0 4rpx 12rpx rgba(225, 72, 60, 0.3);
  font-weight: bold;
}
.ctrl-btn.ghost {
  color: #e1483c;
  border: 1rpx solid #f0b8b2;
  background: #ffffff;
}

/* ===== 授权弹层（.mask/.modal/.modal-title/.modal-sub 使用全局样式） ===== */
.opt-label { font-size: 26rpx; color: #5b616e; margin: 20rpx 0 12rpx; }
.opt-row { display: flex; flex-wrap: wrap; }
.opt-item {
  border: 1rpx solid #e6e8ec;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #14161a;
  background: #ffffff;
}
.opt-item.picker { display: inline-block; color: #5b616e; }
.opt-active {
  border-color: #e1483c;
  color: #e1483c;
  background: #fdecea;
  font-weight: bold;
}
.opt-input {
  background: #ffffff;
  border: 1rpx solid #e6e8ec;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #14161a;
}

/* .modal-btns / .modal-btn 使用全局样式（app.wxss） */
