/* 平台管理页（清透质感：Standard 店铺卡 + Overlay 授权弹层） */
.platform-page {
  background: transparent;
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.plat-head {
  padding: 8rpx 8rpx 24rpx;
}
.plat-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-1);
  letter-spacing: 1rpx;
}
.plat-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.plat-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.page-bottom-space {
  height: 40rpx;
}

/* 店铺行：Standard 玻璃 */
.store-row {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
}
.store-main {
  flex: 1;
  min-width: 0;
}
.store-nm {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
}
.store-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 授权状态标签（半透明语义色底） */
.store-bill {
  margin-top: 16rpx;
  font-size: 22rpx;
  border-radius: var(--radius-pill);
  padding: 4rpx 16rpx;
  display: inline-block;
}
.store-bill.on {
  color: var(--success);
  background: var(--success-tint);
  font-weight: bold;
}
.store-bill.expired {
  color: var(--danger);
  background: var(--danger-tint);
}
.store-bill.off {
  color: var(--text-3);
  background: var(--bg-subtle);
}

/* 操作按钮区 */
.store-ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}
.ctrl-btn {
  font-size: 24rpx;
  border-radius: var(--radius-pill);
  padding: 8rpx 32rpx;
  text-align: center;
  transition: transform var(--duration-fast) var(--ease-out);
}
.ctrl-btn + .ctrl-btn {
  margin-top: 16rpx;
}
.ctrl-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  box-shadow: var(--shadow-soft-1);
  font-weight: bold;
}
.ctrl-btn.ghost {
  color: var(--primary-dark);
  border: 1rpx solid var(--glass-border);
  background: rgba(255, 255, 255, 0.4);
}
.ctrl-btn:active {
  transform: scale(var(--scale-press));
  opacity: 1;
}
.ctrl-btn-disabled {
  color: var(--text-3) !important;
  border-color: transparent !important;
  background: var(--bg-subtle) !important;
}

/* ===== 授权弹层（.mask/.modal/.modal-title/.modal-sub 使用全局样式） ===== */
.opt-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 16rpx 0 16rpx;
}
.opt-row {
  display: flex;
  flex-wrap: wrap;
}
.opt-item {
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-pill);
  padding: 8rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-1);
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.2s ease;
}
.opt-item.picker {
  display: inline-block;
  color: var(--text-2);
}
.opt-active {
  border-color: var(--primary);
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}
.opt-input {
  background: var(--bg-subtle);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-pill);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-1);
}

/* .modal-btns / .modal-btn 使用全局样式（app.wxss） */

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .ctrl-btn.ghost,
  .opt-item {
    background: #f4f6fa;
  }
  .opt-input {
    background: #f4f6fa;
  }
}
@media (prefers-reduced-motion: reduce) {
  .ctrl-btn,
  .opt-item {
    transition: none !important;
  }
  .ctrl-btn:active {
    transform: none;
  }
}
