/* 平台管理页：米色底 + 酒红主调 */
.platform-page {
  background: #f3efe7;
  min-height: 100vh;
  padding: 24rpx 30rpx 0;
  box-sizing: border-box;
}

.plat-head { padding: 10rpx 6rpx 24rpx; }
.plat-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #33241f;
  letter-spacing: 2rpx;
}
.plat-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a7d72;
  line-height: 1.6;
}

.plat-tip {
  text-align: center;
  color: #8a7d72;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.page-bottom-space { height: 40rpx; }

/* 店铺行 */
.store-row {
  display: flex;
  align-items: center;
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(51, 36, 31, 0.05);
}
.store-main { flex: 1; min-width: 0; }
.store-nm {
  font-size: 32rpx;
  font-weight: bold;
  color: #33241f;
}
.store-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7d72;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 授权状态标签 */
.store-bill {
  margin-top: 12rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  display: inline-block;
}
.store-bill.on {
  color: #7e2f2f;
  background: #f5e9e9;
  font-weight: bold;
}
.store-bill.expired { color: #a33a3a; background: #f9ecec; }
.store-bill.off { color: #b0a494; background: #f0ebe2; }

/* 操作按钮区 */
.store-ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}
.ctrl-btn {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
  text-align: center;
}
.ctrl-btn + .ctrl-btn { margin-top: 14rpx; }
.ctrl-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #7e2f2f 0%, #9c4444 100%);
  box-shadow: 0 4rpx 12rpx rgba(126, 47, 47, 0.3);
  font-weight: bold;
}
.ctrl-btn.ghost {
  color: #7e2f2f;
  border: 1rpx solid #d8b7b7;
  background: #fffdf8;
}

/* ===== 授权弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}
.modal-title { text-align: center; font-size: 32rpx; font-weight: bold; color: #33241f; margin-bottom: 12rpx; }
.modal-sub { text-align: center; font-size: 24rpx; color: #a89a8c; margin-bottom: 24rpx; }

.opt-label { font-size: 26rpx; color: #8a7d72; margin: 20rpx 0 12rpx; }
.opt-row { display: flex; flex-wrap: wrap; }
.opt-item {
  border: 1rpx solid #d8cfbf;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #33241f;
  background: #fffdf8;
}
.opt-item.picker { display: inline-block; color: #8a7d72; }
.opt-active {
  border-color: #7e2f2f;
  color: #7e2f2f;
  background: #f5e9e9;
  font-weight: bold;
}
.opt-input {
  background: #fffdf8;
  border: 1rpx solid #d8cfbf;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #33241f;
}

.modal-btns { display: flex; margin-top: 36rpx; }
.modal-btn { flex: 1; }
.modal-btn.primary { margin-left: 24rpx; }
