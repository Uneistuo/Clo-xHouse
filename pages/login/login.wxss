/* 登录页样式（米色底 + 酒红主调） */
.login-page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 180rpx 60rpx 0;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  color: #14161a;
  margin-bottom: 90rpx;
}
.login-logo {
  width: 130rpx;
  height: 130rpx;
  line-height: 130rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
  color: #fff;
  font-size: 64rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(225, 72, 60, 0.28);
}
.login-title { font-size: 40rpx; font-weight: bold; color: #14161a; }
.login-sub { font-size: 24rpx; color: #5b616e; margin-top: 12rpx; }

/* 登录表单：位于切换标签下方，仅下圆角 */
.login-form {
  background: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 48rpx 40rpx;
}
.login-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eceef1;
  padding: 28rpx 0;
}
.login-label { width: 110rpx; font-size: 30rpx; color: #14161a; }
.login-input { flex: 1; font-size: 30rpx; color: #14161a; }
/* .placeholder 使用全局样式（app.wxss） */

.login-btn { margin-top: 60rpx; font-size: 32rpx; }

/* 登录/注册切换标签 */
.mode-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 40rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(20, 22, 26, 0.08);
}
.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #5b616e;
  padding-bottom: 24rpx;
  border-bottom: 4rpx solid transparent;
}
.mode-tab.active {
  color: #e1483c;
  font-weight: bold;
  border-bottom-color: #e1483c;
}

.register-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #9aa0ac;
  text-align: center;
}
