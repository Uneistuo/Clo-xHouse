/* 登录页样式（米色底 + 酒红主调） */
.login-page {
  min-height: 100vh;
  background: #f3efe7;
  padding: 180rpx 60rpx 0;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  color: #33241f;
  margin-bottom: 90rpx;
}
.login-logo {
  width: 130rpx;
  height: 130rpx;
  line-height: 130rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #7e2f2f 0%, #9c4444 100%);
  color: #fff;
  font-size: 64rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(126, 47, 47, 0.28);
}
.login-title { font-size: 40rpx; font-weight: bold; color: #33241f; }
.login-sub { font-size: 24rpx; color: #8a7d72; margin-top: 12rpx; }

.login-form {
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(51, 36, 31, 0.08);
}
.login-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ece5d8;
  padding: 28rpx 0;
}
.login-label { width: 110rpx; font-size: 30rpx; color: #33241f; }
.login-input { flex: 1; font-size: 30rpx; color: #33241f; }
.placeholder { color: #c4b8a8; }

.login-btn { margin-top: 60rpx; font-size: 32rpx; }

/* 登录/注册切换标签 */
.mode-tabs {
  display: flex;
  background: #fffdf8;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 40rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(51, 36, 31, 0.08);
}
.mode-tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #8a7d72;
  padding-bottom: 24rpx;
  border-bottom: 4rpx solid transparent;
}
.mode-tab.active {
  color: #7e2f2f;
  font-weight: bold;
  border-bottom-color: #7e2f2f;
}

.login-form {
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: none;
}

.register-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #a09286;
  text-align: center;
}
