/* 裁间 · 登录 / 注册页（清透质感：Hero 玻璃面板 + Wash 输入框） */

.login-page {
  position: relative;
  min-height: 100vh;
  background: transparent;
  overflow: hidden;
}

/* ===== 背景光晕：统一由全局 page::before / ::after 提供 ===== */
.glow {
  display: none;
}

/* ===== 布局 ===== */
.login-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  padding: 112rpx 56rpx 64rpx;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 品牌区 ===== */
.brand {
  text-align: center;
  margin-bottom: 64rpx;
}
.brand-title {
  font-size: var(--font-h1);
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: 16rpx;
  text-indent: 16rpx;
  line-height: 1.1;
}
.brand-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  margin: 24rpx auto 0;
  background: linear-gradient(90deg, #8a9bf9 0%, #b3a1fb 100%);
}
.brand-sub {
  font-size: 24rpx;
  color: var(--text-2);
  letter-spacing: 2rpx;
  margin-top: 24rpx;
}

/* ===== 主卡片（Hero 白玻璃：透光 + 高浮层阴影） ===== */
.panel {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.62);
  border-radius: var(--radius-hero);
  padding: 40rpx 40rpx 44rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-float), var(--inner-light);
  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);
}

/* ===== 输入项（Wash 层玻璃化） ===== */
.field {
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-input);
  padding: 16rpx 24rpx;
  transition:
    background 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}
.field.is-focus {
  background: rgba(255, 255, 255, 0.85);
  border-color: transparent;
  box-shadow: 0 0 0 6rpx rgba(123, 140, 247, 0.14);
}
.field.is-error {
  background: rgba(255, 255, 255, 0.85);
  border-color: var(--danger);
  box-shadow: 0 0 0 6rpx rgba(224, 93, 87, 0.08);
}
.field-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.field-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-1);
  line-height: 1.4;
}
.ph {
  color: var(--text-placeholder);
}
.field-tip {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* ===== 提交按钮（渐变是状态：主色渐变 + 主色投影） ===== */
.login-btn {
  width: 100%;
  margin-top: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff;
  line-height: 1.4;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-radius: var(--radius-pill);
  padding: 24rpx 0;
  box-shadow: var(--shadow-primary);
  transition:
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}
.login-btn::after {
  border: none;
}
.login-btn:active {
  transform: scale(var(--scale-press));
  box-shadow: 0 8rpx 20rpx rgba(123, 140, 247, 0.18);
}
.login-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}
.btn-loading {
  position: relative;
  color: transparent !important;
  pointer-events: none;
}
.login-btn.btn-loading::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  margin-top: -17rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: btnSpin 0.8s linear infinite;
}
@keyframes btnSpin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 底部切换 ===== */
.foot {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.foot-link {
  color: var(--primary-dark);
  font-weight: 600;
  margin-left: 8rpx;
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .panel {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .field {
    background: #f4f6fa;
    border-color: rgba(29, 34, 43, 0.1);
  }
  .field.is-focus {
    background: #ffffff;
  }
}
@media (prefers-reduced-motion: reduce) {
  .field,
  .login-btn {
    transition: none !important;
  }
  .login-btn:active {
    transform: none;
  }
}
