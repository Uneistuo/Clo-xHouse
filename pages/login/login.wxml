<!--登录/注册页-->
<view class="login-page">
  <view class="login-header">
    <view class="login-logo">衣</view>
    <view class="login-title">服装店商家管理</view>
    <view class="login-sub">店主登录 · 门店经营好帮手</view>
  </view>

  <!-- 登录 / 注册 切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">账号登录</view>
    <view class="mode-tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">注册账号</view>
  </view>

  <!-- 登录表单 -->
  <view class="login-form" wx:if="{{mode === 'login'}}">
    <view class="login-item">
      <text class="login-label">账号</text>
      <input class="login-input" placeholder="请输入商家账号" value="{{username}}"
             bindinput="onUsernameInput" placeholder-class="placeholder" />
    </view>
    <view class="login-item">
      <text class="login-label">密码</text>
      <input class="login-input" placeholder="请输入密码" password value="{{password}}"
             bindinput="onPasswordInput" placeholder-class="placeholder" />
    </view>
    <button class="btn-primary login-btn" bindtap="handleLogin"
            disabled="{{loading}}">{{loading ? '登录中...' : '登 录'}}</button>
  </view>

  <!-- 注册表单（自由注册，注册后绑定店铺即可同步数据） -->
  <view class="login-form" wx:else>
    <view class="login-item">
      <text class="login-label">账号</text>
      <input class="login-input" placeholder="3-20位字母、数字或下划线" value="{{username}}"
             bindinput="onUsernameInput" placeholder-class="placeholder" />
    </view>
    <view class="login-item">
      <text class="login-label">密码</text>
      <input class="login-input" placeholder="6-32位密码" password value="{{password}}"
             bindinput="onPasswordInput" placeholder-class="placeholder" />
    </view>
    <view class="login-item">
      <text class="login-label">确认密码</text>
      <input class="login-input" placeholder="请再次输入密码" password value="{{confirmPassword}}"
             bindinput="onConfirmPasswordInput" placeholder-class="placeholder" />
    </view>
    <view class="register-tip">注册后可创建自己的店铺，或凭店铺码加入已有店铺</view>
    <button class="btn-primary login-btn" bindtap="handleRegister"
            disabled="{{loading}}">{{loading ? '提交中...' : '注 册'}}</button>
  </view>
</view>
