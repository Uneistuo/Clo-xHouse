/* 开单页样式（清透质感：Wash 搜索/输入 + Dense 商品行 + Standard 购物车 + Overlay 结算栏） */
.bill-page {
  /* 固定结算栏（约 134rpx）+ 悬浮 TabBar（124rpx）+ 呼吸间距 */
  padding-bottom: calc(var(--space-tabbar-bottom, 124rpx) + 160rpx + env(safe-area-inset-bottom));
}
/* 未获开单权限时，无结算栏，底部只需避让 TabBar */
.bill-page.restricted {
  padding-bottom: calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom));
}

.search-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  margin: 8rpx 0 24rpx;
  border: 1rpx solid var(--glass-border);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 16rpx;
  color: var(--text-3);
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
}

/* 商品行：Dense 密集层（长列表强制不模糊） */
.goods-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: var(--bg-card-strong);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-1);
}
.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  flex-shrink: 0;
  border: 1rpx solid var(--glass-border);
}
/* P1-4：图片加载失败/无图占位
   注意：始终与 .goods-img 组合使用（class="goods-img goods-img-empty"），
   渐变底、描边与尺寸均由 .goods-img 提供，此处只负责居中与图标色。 */
.goods-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
}
.goods-img-empty .icon {
  font-size: 56rpx;
  opacity: 0.6;
}
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.goods-name {
  font-size: var(--font-h3);
  font-weight: bold;
  color: var(--text-1);
}
.goods-price {
  font-size: 30rpx;
  margin: 8rpx 0;
  color: var(--primary);
  font-weight: bold;
}
.goods-stock {
  font-size: 24rpx;
  color: var(--text-2);
}
/* 断货颜色由 app.wxss 的 .stock-zero 统一提供 */

/* P1-3：分页加载提示 */
.loading-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 24rpx 0;
}
.add-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: var(--shadow-primary);
  transition: transform var(--duration-fast) var(--ease-out);
}
.add-btn:active {
  transform: scale(var(--scale-press));
}

.empty-card {
  border: 1rpx dashed var(--glass-border);
  border-radius: var(--radius-card);
  background: rgba(255, 255, 255, 0.5);
  text-align: center;
  padding: 88rpx 0 80rpx;
}
.empty-card .empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}
.empty-title {
  font-size: 32rpx;
  color: var(--text-1);
  font-weight: bold;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 16rpx;
}

.expire-banner {
  background: var(--primary-tint);
  color: var(--primary-dark);
  border-radius: var(--radius-input);
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.restricted-card {
  padding: 100rpx 40rpx 88rpx;
}
.restricted-card .empty-sub {
  padding: 0 32rpx;
  line-height: 1.7;
}

.cart-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin: 32rpx 8rpx 16rpx;
}
.cart-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: var(--radius-input);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-soft-1);
}
.cart-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #eef0f9 0%, #f7f4f0 100%);
  flex-shrink: 0;
}
.cart-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.cart-spec {
  display: flex;
  align-items: center;
  margin: 8rpx 0;
}
.cart-spec .tag {
  margin-right: 16rpx;
}
.cart-spec .price {
  margin-left: auto;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: bold;
}
.cart-ctrl {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cart-remove {
  color: var(--danger);
  font-size: 24rpx;
}

.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-sm);
  color: var(--text-1);
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.6);
  transition: transform var(--duration-fast) var(--ease-out);
}
.step-btn:active {
  transform: scale(var(--scale-press));
}
.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.big-stepper {
  margin: 8rpx 0 0;
}

.field-block {
  margin: 32rpx 8rpx 0;
}
.field-label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.field-input {
  background: var(--bg-subtle);
  border-radius: var(--radius-input);
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-shadow: inset 0 1rpx 2rpx rgba(35, 45, 75, 0.04);
  border: 1rpx solid var(--glass-border);
}
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-input);
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-shadow: inset 0 1rpx 2rpx rgba(35, 45, 75, 0.04);
  border: 1rpx solid var(--glass-border);
}

.phone-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.phone-input {
  flex: 1;
  width: auto;
  min-width: 0;
}
.add-customer-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-radius: 999rpx;
  line-height: 1.4;
  white-space: nowrap;
  box-shadow: var(--shadow-soft-1);
}
.add-customer-btn:active {
  opacity: 0.7;
}
.phone-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  transition: color var(--duration-fast);
}
.phone-count.done {
  color: var(--success);
}

.customer-matches {
  margin-top: 16rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-input);
  padding: 16rpx;
  border: 1rpx solid var(--glass-border);
}
.customer-matches-title {
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}
.customer-match-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--hairline);
}
.customer-match-item:last-child {
  border-bottom: none;
}
.customer-match-item:active {
  background: rgba(255, 255, 255, 0.5);
}
.match-name {
  font-weight: 500;
}
.match-phone {
  color: var(--text-2);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.modal-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  margin: 0 0 24rpx;
  letter-spacing: 1rpx;
}
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* 结算栏：固定在底部，与悬浮 TabBar 无缝拼接为同一块 Overlay 面板 */
.footer-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  /* 向上叠 1rpx 盖住 TabBar 顶边，避免拼接处出现发丝缝 */
  bottom: calc(var(--space-tabbar-bottom, 124rpx) - 1rpx + env(safe-area-inset-bottom));
  z-index: 101; /* 高于 TabBar(100)，低于遮罩(1000) */
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  /* 与商品批量栏共用同一高度令牌，切换页面时面板轮廓不跳变 */
  min-height: var(--dock-bar-height, 136rpx);
  padding: 24rpx 32rpx;
  margin: 0;
  background: var(--bg-overlay);
  border: 1rpx solid var(--glass-border);
  border-bottom: none;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-shadow:
    0 -14rpx 40rpx rgba(35, 45, 75, 0.08),
    var(--inner-light);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
.footer-left {
  display: flex;
  flex-direction: column;
}
.footer-spec {
  font-size: 22rpx;
  color: var(--text-2);
}
.footer-price {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary);
  margin-top: 4rpx;
}
.footer-btn {
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
  transition:
    transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}
.footer-btn:active {
  transform: scale(var(--scale-press));
  box-shadow: 0 8rpx 20rpx rgba(123, 140, 247, 0.18);
}
.footer-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.spec-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 16rpx 0 12rpx;
}
.spec-row {
  display: flex;
  flex-wrap: wrap;
}
.spec-item {
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-1);
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.2s ease;
}
.spec-active {
  border-color: var(--primary);
  color: var(--primary-dark);
  background: var(--primary-tint);
  font-weight: bold;
}
/* 库存 < LOW_STOCK：虚线边框 + 橙色提示（P1 规格选择器增强） */
.spec-low {
  border-style: dashed;
  border-color: var(--warning);
  color: var(--warning);
}
.spec-low.spec-active {
  border-color: var(--primary);
  color: var(--primary-dark);
}
.spec-recent {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--primary-dark);
  opacity: 0.85;
}
.spec-low .spec-recent {
  color: var(--warning);
}
.spec-label-low {
  color: var(--warning);
}
.spec-low-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--warning);
}
.spec-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.success-modal {
  text-align: center;
  padding: 48rpx 40rpx 32rpx;
}
.success-icon {
  font-size: 96rpx;
  color: var(--success);
  margin-bottom: 16rpx;
}
.success-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
}
.success-order {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 16rpx;
}
.success-amount {
  font-size: var(--font-h1);
  font-weight: bold;
  color: var(--primary);
  margin: 16rpx 0 8rpx;
}
.success-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.success-status.paid {
  background: var(--success-tint);
  color: var(--success);
}
.success-status.pending {
  background: var(--warning-tint);
  color: var(--warning);
}
.success-reprint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
  text-decoration: underline;
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .search-wrap,
  .field-input,
  .field-textarea,
  .spec-item {
    background: #f4f6fa;
  }
  .footer-bar {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .add-btn,
  .step-btn,
  .footer-btn,
  .spec-item {
    transition: none !important;
  }
  .add-btn:active,
  .step-btn:active,
  .footer-btn:active {
    transform: none;
  }
}
