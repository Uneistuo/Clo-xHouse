/* 开单页样式 */
.bill-page { padding-bottom: 220rpx; }

/* ===== 搜索框（与商品页一致） ===== */
.search-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  margin: 10rpx 0 24rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }

/* ===== 商品行 ===== */
.goods-row { display: flex; align-items: center; padding: 20rpx; margin-bottom: 20rpx; }
.goods-img { width: 120rpx; height: 120rpx; border-radius: 16rpx; background: #f0f1f4; flex-shrink: 0; }
.goods-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.goods-name { font-size: 28rpx; font-weight: bold; color: #14161a; }
.goods-price { font-size: 30rpx; margin: 8rpx 0; }
.goods-stock { font-size: 24rpx; color: #5b616e; }
.stock-warn { color: #dc2626; }
.add-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
  color: #fff;
  font-size: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(225, 72, 60, 0.3);
}

/* ===== 空状态（虚线卡片） ===== */
.empty-card {
  border: 2rpx dashed #e6e8ec;
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.6);
  text-align: center;
  padding: 90rpx 0 80rpx;
}
.empty-card .empty-icon { font-size: 72rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; color: #14161a; font-weight: bold; }
.empty-sub { font-size: 24rpx; color: #9aa0ac; margin-top: 14rpx; }

/* ===== 开单授权到期时间提示 ===== */
.expire-banner {
  background: #fdecea;
  color: #e1483c;
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 20rpx;
}

/* ===== 开单白名单受限卡片 ===== */
.restricted-card { padding: 100rpx 40rpx 90rpx; }
.restricted-card .empty-sub { padding: 0 30rpx; line-height: 1.7; }

/* ===== 已选商品 ===== */
.cart-title { font-size: 28rpx; font-weight: bold; color: #14161a; margin: 32rpx 6rpx 16rpx; }
.cart-item { display: flex; padding: 20rpx; margin-bottom: 20rpx; }
.cart-img { width: 110rpx; height: 110rpx; border-radius: 16rpx; background: #f0f1f4; flex-shrink: 0; }
.cart-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.cart-spec { display: flex; align-items: center; margin: 8rpx 0; }
.cart-spec .tag { margin-right: 12rpx; }
.cart-spec .price { margin-left: auto; font-size: 28rpx; }
.cart-ctrl { display: flex; justify-content: space-between; align-items: center; }
.cart-remove { color: #dc2626; font-size: 24rpx; }

/* ===== 数量步进器 ===== */
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border: 1rpx solid #e6e8ec;
  border-radius: 8rpx;
  color: #14161a;
  font-size: 30rpx;
  background: #ffffff;
}
.step-num { min-width: 70rpx; text-align: center; font-size: 28rpx; color: #14161a; }
.big-stepper { margin: 10rpx 0 0; }

/* ===== 表单字段（手机 / 备注） ===== */
.field-block { margin: 32rpx 6rpx 0; }
.field-label { font-size: 28rpx; font-weight: bold; color: #14161a; margin-bottom: 14rpx; }
.field-input {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #14161a;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #14161a;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}

/* 顾客手机：输入栏 + 末端"添加会员"按钮（flex 并排） */
.phone-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.phone-input {
  flex: 1;
  width: auto;       /* 覆盖 .field-input 的默认 block 满宽 */
  min-width: 0;
}
.add-customer-btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: #e1483c;
  border-radius: 999rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.add-customer-btn:active { opacity: 0.7; }

/* 会员预选列表：输入 4 位后下方显示 */
.customer-matches {
  margin-top: 16rpx;
  background: #f8f9fb;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.customer-matches-title {
  font-size: 22rpx;
  color: #9aa0ac;
  margin-bottom: 10rpx;
}
.customer-match-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #14161a;
  border-bottom: 1rpx solid #eceef1;
}
.customer-match-item:last-child { border-bottom: none; }
.customer-match-item:active { background: rgba(0, 0, 0, 0.03); }
.match-name { font-weight: 500; }
.match-phone { color: #5b616e; font-size: 24rpx; letter-spacing: 1rpx; }

/* 添加会员弹窗：姓氏输入 + 性别二选一 */
.modal-sub {
  text-align: center;
  font-size: 26rpx;
  color: #5b616e;
  margin: -8rpx 0 24rpx;
  letter-spacing: 1rpx;
}
/* 性别二选一（参考商品编辑页尺码选择：整体胶囊 + 中间分隔） */
.gender-options {
  display: flex;
  flex: 1;                 /* 撑满表单行剩余宽度，避免胶囊只有文字那么短 */
  border: 1rpx solid #e6e8ec;
  border-radius: 999rpx;
  overflow: hidden;
}
.gender-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #5b616e;
  background: #ffffff;
}
.gender-option + .gender-option { border-left: 1rpx solid #e6e8ec; }
.gender-option.active {
  color: #e1483c;
  background: #fdecea;
  font-weight: bold;
}

/* 弹窗按钮：两按钮同高胶囊，取消略窄于确认 */
.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

/* ===== 当场已收款卡片 ===== */
.paid-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin: 32rpx 6rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(20, 22, 26, 0.05);
}
.paid-title { font-size: 28rpx; font-weight: bold; color: #14161a; }
.paid-sub { font-size: 24rpx; color: #9aa0ac; margin-top: 8rpx; }

.page-bottom-space { height: 40rpx; }

/* ===== 底部结算栏 ===== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #f4f5f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eceef1;
}
.footer-left { display: flex; flex-direction: column; }
.footer-spec { font-size: 22rpx; color: #5b616e; }
.footer-price { font-size: 44rpx; font-weight: bold; color: #e1483c; margin-top: 4rpx; }
.footer-btn {
  background: linear-gradient(135deg, #e1483c 0%, #c5362c 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx 54rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(225, 72, 60, 0.3);
}
.footer-btn.disabled {
  background: #f0b4ae;
  box-shadow: none;
}

/* ===== 规格选择弹层（.mask/.modal/.modal-title 使用全局样式） ===== */
.spec-label { font-size: 26rpx; color: #5b616e; margin: 16rpx 0 12rpx; }
.spec-row { display: flex; flex-wrap: wrap; }
.spec-item {
  border: 1rpx solid #e6e8ec;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #14161a;
  background: #ffffff;
}
.spec-active {
  border-color: #e1483c;
  color: #e1483c;
  background: #fdecea;
  font-weight: bold;
}
/* .modal-btns / .modal-btn 使用全局样式（app.wxss） */

/* ===== 开单成功卡片 ===== */
.success-modal { text-align: center; padding: 48rpx 40rpx 32rpx; }
.success-icon { font-size: 96rpx; color: #16a34a; margin-bottom: 16rpx; }
.success-title { font-size: 32rpx; font-weight: bold; color: #14161a; }
.success-order { font-size: 24rpx; color: #5b616e; margin-top: 12rpx; }
.success-amount { font-size: 60rpx; font-weight: bold; color: #e1483c; margin: 16rpx 0 8rpx; }
.success-status { display: inline-block; font-size: 22rpx; padding: 4rpx 20rpx; border-radius: 999rpx; }
.success-status.paid { background: #e7f6ec; color: #16a34a; }
.success-status.pending { background: #fef3e2; color: #b45309; }
.success-reprint { margin-top: 24rpx; font-size: 26rpx; color: #5b616e; text-decoration: underline; }