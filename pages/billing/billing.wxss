/* 开单页样式（优化版：CSS 变量） */
.bill-page {
  padding-bottom: 220rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  margin: 10rpx 0 24rpx;
  border: 1rpx solid var(--border-strong);
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: var(--text-2);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

.goods-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
  border: 1rpx solid var(--border);
}
/* P1-4：图片加载失败/无图占位 */
.goods-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
}
.goods-img-empty .icon {
  font-size: 48rpx;
}
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
}
.goods-price {
  font-size: 30rpx;
  margin: 8rpx 0;
  color: var(--primary);
  font-weight: bold;
}
.goods-stock {
  font-size: 24rpx;
  color: var(--text-2);
}
.stock-warn {
  color: var(--danger);
}

/* P1-3：分页加载提示 */
.loading-tip {
  text-align: center;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 24rpx 0;
}
.add-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: var(--shadow-primary);
}

.empty-card {
  border: 2rpx dashed var(--border);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.6);
  text-align: center;
  padding: 90rpx 0 80rpx;
}
.empty-card .empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 32rpx;
  color: var(--text-1);
  font-weight: bold;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 14rpx;
}

.expire-banner {
  background: var(--primary-tint);
  color: var(--primary-dark);
  border-radius: 16rpx;
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 20rpx;
}

.restricted-card {
  padding: 100rpx 40rpx 90rpx;
}
.restricted-card .empty-sub {
  padding: 0 30rpx;
  line-height: 1.7;
}

.cart-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin: 32rpx 6rpx 16rpx;
}
.cart-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
}
.cart-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.cart-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.cart-spec {
  display: flex;
  align-items: center;
  margin: 8rpx 0;
}
.cart-spec .tag {
  margin-right: 12rpx;
}
.cart-spec .price {
  margin-left: auto;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: bold;
}
.cart-ctrl {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cart-remove {
  color: var(--danger);
  font-size: 24rpx;
}

.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border: 1rpx solid var(--border-strong);
  border-radius: 8rpx;
  color: var(--text-1);
  font-size: 30rpx;
  background: var(--bg-card);
}
.step-num {
  min-width: 70rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-1);
}
.big-stepper {
  margin: 10rpx 0 0;
}

.field-block {
  margin: 32rpx 6rpx 0;
}
.field-label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 14rpx;
}
.field-input {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border-strong);
}
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border-strong);
}

.phone-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.phone-input {
  flex: 1;
  width: auto;
  min-width: 0;
}
.add-customer-btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: var(--primary);
  border-radius: 999rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.add-customer-btn:active {
  opacity: 0.7;
}

.customer-matches {
  margin-top: 16rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border);
}
.customer-matches-title {
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}
.customer-match-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--divider);
}
.customer-match-item:last-child {
  border-bottom: none;
}
.customer-match-item:active {
  background: rgba(0, 0, 0, 0.03);
}
.match-name {
  font-weight: 500;
}
.match-phone {
  color: var(--text-2);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.modal-sub {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  margin: -8rpx 0 24rpx;
  letter-spacing: 1rpx;
}
.gender-options {
  display: flex;
  flex: 1;
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  overflow: hidden;
}
.gender-option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-card);
}
.gender-option + .gender-option {
  border-left: 1rpx solid var(--border);
}
.gender-option.active {
  color: var(--primary);
  background: var(--primary-tint);
  font-weight: bold;
}

.modal-btns .btn-ghost.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.modal-btns .btn-primary.modal-btn {
  flex: 1.4;
  margin-left: 24rpx;
}

.paid-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin: 32rpx 6rpx 0;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border);
}
.paid-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
}
.paid-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.page-bottom-space {
  height: 40rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 12rpx rgba(20, 22, 26, 0.06);
}
.footer-left {
  display: flex;
  flex-direction: column;
}
.footer-spec {
  font-size: 22rpx;
  color: var(--text-2);
}
.footer-price {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary);
  margin-top: 4rpx;
}
.footer-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 24rpx 54rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-primary);
}
.footer-btn.disabled {
  background: #f0b4ae;
  box-shadow: none;
}

.spec-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 16rpx 0 12rpx;
}
.spec-row {
  display: flex;
  flex-wrap: wrap;
}
.spec-item {
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--bg-card);
}
.spec-active {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-tint);
  font-weight: bold;
}

.success-modal {
  text-align: center;
  padding: 48rpx 40rpx 32rpx;
}
.success-icon {
  font-size: 96rpx;
  color: var(--success);
  margin-bottom: 16rpx;
}
.success-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-1);
}
.success-order {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}
.success-amount {
  font-size: 60rpx;
  font-weight: bold;
  color: var(--primary);
  margin: 16rpx 0 8rpx;
}
.success-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}
.success-status.paid {
  background: var(--success-tint);
  color: var(--success);
}
.success-status.pending {
  background: var(--warning-tint);
  color: var(--warning);
}
.success-reprint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
  text-decoration: underline;
}
