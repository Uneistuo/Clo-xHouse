<!--开单页：商家现场出单-->
<view class="page bill-page">
  <!-- 开单授权到期时间提示（有效授权时展示） -->
  <view wx:if="{{billingExpireText}}" class="expire-banner">开单授权至 {{billingExpireText}}</view>

  <!-- 开单白名单受限：未授权/已到期店铺不可开单 -->
  <view wx:if="{{restricted}}" class="empty-card restricted-card">
    <view class="empty-icon">{{restrictedExpired ? '⏳' : '🔒'}}</view>
    <view class="empty-title">{{restrictedExpired ? '开单授权已到期' : '开单功能未开通'}}</view>
    <view class="empty-sub" wx:if="{{restrictedExpired}}">您的店铺开单授权已到期，请联系平台管理员续期后再开单。商品与订单数据不受影响。</view>
    <view class="empty-sub" wx:else>您的店铺尚未获得开单授权，请联系平台管理员开通后再开单。商品与订单数据不受影响。</view>
  </view>

  <block wx:else>
  <!-- 商品搜索 -->
  <view class="search-wrap">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索在售商品" value="{{keyword}}"
           bindinput="onKeywordInput" placeholder-class="ph" />
  </view>

  <!-- 商品列表（仅上架商品；空表显示空状态） -->
  <view wx:if="{{goodsList.length === 0}}" class="empty-card">
    <view class="empty-icon">🛍️</view>
    <view class="empty-title">没有可开单的商品</view>
    <view class="empty-sub">请先在商品页录入并上架，有库存后即可选择。</view>
  </view>

  <view wx:for="{{goodsList}}" wx:key="id" class="card goods-row">
    <image class="goods-img" src="{{item.cover}}" mode="aspectFill" />
    <view class="goods-info">
      <view class="goods-name ellipsis">{{item.name}}</view>
      <view class="goods-price price">￥{{item.priceText}}</view>
      <view class="goods-stock {{item.stock <= 0 ? 'stock-warn' : ''}}">库存 {{item.stock}}</view>
    </view>
    <view class="add-btn" data-id="{{item.id}}" bindtap="openSelect">＋</view>
  </view>

  <!-- 已选订单商品 -->
  <view wx:if="{{cart.length > 0}}" class="cart-title">已选商品（{{totalQuantity}} 件）</view>
  <view wx:for="{{cart}}" wx:key="index" class="card cart-item">
    <image class="cart-img" src="{{item.cover}}" mode="aspectFill" />
    <view class="cart-info">
      <view class="goods-name ellipsis">{{item.name}}</view>
      <view class="cart-spec">
        <text wx:if="{{item.color}}" class="tag">{{item.color}}</text>
        <text wx:if="{{item.size}}" class="tag">{{item.size}}</text>
        <text class="price">￥{{item.subtotal}}</text>
      </view>
      <view class="cart-ctrl">
        <view class="stepper">
          <view class="step-btn" data-index="{{index}}" bindtap="cartMinus">−</view>
          <view class="step-num">{{item.quantity}}</view>
          <view class="step-btn" data-index="{{index}}" bindtap="cartPlus">＋</view>
        </view>
        <view class="cart-remove" data-index="{{index}}" bindtap="cartRemove">移除</view>
      </view>
    </view>
  </view>

  <!-- 顾客手机（选填） -->
  <view class="field-block">
    <view class="field-label">顾客手机（选填）</view>
    <input class="field-input" type="number" placeholder="方便售后联系" value="{{customerPhone}}"
           bindinput="onPhoneInput" placeholder-class="ph" />
  </view>

  <!-- 订单备注 -->
  <view class="field-block">
    <view class="field-label">订单备注</view>
    <textarea class="field-textarea" placeholder="改裤长、改期取件..." value="{{remark}}"
              bindinput="onRemarkInput" placeholder-class="ph" auto-height maxlength="200" />
  </view>

  <!-- 当场已收款 -->
  <view class="paid-card">
    <view class="paid-info">
      <view class="paid-title">当场已收款</view>
      <view class="paid-sub">现金 / 微信转账给店主</view>
    </view>
    <switch checked="{{paidNow}}" bindchange="onPaidNowChange" color="#7E2F2F" />
  </view>

  <view class="page-bottom-space"></view>

  <!-- 底部结算栏 -->
  <view class="footer-bar">
    <view class="footer-left">
      <view class="footer-spec">{{cart.length}} 种规格</view>
      <view class="footer-price">¥{{totalAmount}}</view>
    </view>
    <view class="footer-btn {{cart.length === 0 || submitting ? 'disabled' : ''}}" bindtap="submitOrder">
      {{submitting ? '提交中...' : '收款并出单'}}
    </view>
  </view>

  <!-- 规格选择弹层 -->
  <view wx:if="{{selectVisible}}" class="mask" bindtap="closeSelect">
    <view class="modal" catchtap="">
      <view class="modal-title">{{selGoods.name}}</view>
      <view wx:if="{{selColors.length}}">
        <view class="spec-label">颜色</view>
        <view class="spec-row">
          <view wx:for="{{selColors}}" wx:key="*this"
                class="spec-item {{selColor === item ? 'spec-active' : ''}}"
                data-v="{{item}}" bindtap="pickColor">{{item}}</view>
        </view>
      </view>
      <view wx:if="{{selSizes.length}}">
        <view class="spec-label">尺码</view>
        <view class="spec-row">
          <view wx:for="{{selSizes}}" wx:key="*this"
                class="spec-item {{selSize === item ? 'spec-active' : ''}}"
                data-v="{{item}}" bindtap="pickSize">{{item}}</view>
        </view>
      </view>
      <view class="spec-label">数量（该规格库存 {{selSkuStock}}）</view>
      <view class="stepper big-stepper">
        <view class="step-btn" bindtap="selQtyMinus">−</view>
        <view class="step-num">{{selQty}}</view>
        <view class="step-btn" bindtap="selQtyPlus">＋</view>
      </view>
      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeSelect">取消</button>
        <button class="btn-primary modal-btn primary" bindtap="confirmAdd">加入订单</button>
      </view>
    </view>
  </view>
  </block>
</view>
