<!--开单页：商家现场出单-->
<view class="page glow-page bill-page {{restricted ? 'restricted' : ''}}">
  <!-- 开单授权到期时间提示（有效授权时展示） -->
  <view wx:if="{{billingExpireText}}" class="expire-banner">开单授权至 {{billingExpireText}}</view>

  <!-- 开单白名单受限：未授权/已到期店铺不可开单 -->
  <view wx:if="{{restricted}}" class="empty-card restricted-card">
    <view class="empty-icon icon {{restrictedExpired ? 'icon-hourglass' : 'icon-lock'}}"></view>
    <view class="empty-title">{{restrictedExpired ? '开单授权已到期' : '开单功能未开通'}}</view>
    <view class="empty-sub" wx:if="{{restrictedExpired}}">您的店铺开单授权已到期，请联系平台管理员续期后再开单。商品与订单数据不受影响。</view>
    <view class="empty-sub" wx:else>您的店铺尚未获得开单授权，请联系平台管理员开通后再开单。商品与订单数据不受影响。</view>
  </view>

  <block wx:else>
  <!-- 商品搜索 -->
  <view class="search-wrap">
    <view class="icon icon-search search-icon"></view>
    <input class="search-input" placeholder="搜索在售商品" value="{{keyword}}"
           bindinput="onKeywordInput" placeholder-class="ph" />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">×</view>
  </view>

  <!-- 商品列表（仅上架商品）：加载中 / 空状态 / 分页列表（P1-3） -->
  <!-- 骨架屏（首次加载，统一使用 skeleton-card 组件） -->
  <block wx:if="{{loading && goodsList.length === 0}}">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="card goods-row">
      <skeleton-card
        avatar="{{true}}"
        avatar-size="{{120}}"
        rows="{{3}}"
        heights="30,24,24"
        widths="55%,35%,50%"
        gap="{{16}}"
      />
    </view>
  </block>
  <view wx:elif="{{goodsList.length === 0}}" class="empty-card">
    <view class="empty-icon icon icon-shopping-bag"></view>
    <view class="empty-title">没有可开单的商品</view>
    <view class="empty-sub">请先在商品页录入并上架，有库存后即可选择。</view>
  </view>

  <view wx:for="{{goodsList}}" wx:key="id" class="card goods-row">
    <!-- P1-4：图片懒加载，加载失败/无图时展示占位图 -->
    <image wx:if="{{item.cover}}" class="goods-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"
           binderror="onGoodsImgError" data-index="{{index}}" aria-label="{{item.name}}" />
    <view wx:else class="goods-img goods-img-empty"><view class="icon icon-shopping-bag" aria-hidden="true"></view></view>
    <view class="goods-info">
      <view class="goods-name ellipsis">{{item.name}}</view>
      <view class="goods-price price">￥{{item.priceText}}</view>
      <view class="goods-stock {{item.stock <= 0 ? 'stock-zero' : ''}}">库存 {{item.stock}}</view>
    </view>
    <view class="add-btn" data-id="{{item.id}}" bindtap="openSelect"
          aria-role="button" aria-label="添加{{item.name}}"><view class="icon icon-plus" aria-hidden="true"></view></view>
  </view>

  <!-- 分页加载提示 -->
  <view wx:if="{{loading && goodsList.length > 0}}" class="loading-tip">加载中…</view>
  <view wx:elif="{{hasMore && goodsList.length > 0}}" class="loading-tip">上拉加载更多</view>
  <view wx:elif="{{goodsList.length > 0}}" class="loading-tip">没有更多商品了</view>

  <!-- 已选订单商品 -->
  <view wx:if="{{cart.length > 0}}" class="cart-title">已选商品（{{totalQuantity}} 件）</view>
  <view wx:for="{{cart}}" wx:key="index" class="card cart-item">
    <image class="cart-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" aria-label="{{item.name}}" />
    <view class="cart-info">
      <view class="goods-name ellipsis">{{item.name}}</view>
      <view class="cart-spec">
        <text wx:if="{{item.color}}" class="tag">{{item.color}}</text>
        <text wx:if="{{item.size}}" class="tag">{{item.size}}</text>
        <text class="price">￥{{item.subtotal}}</text>
      </view>
      <view class="cart-ctrl">
        <view class="stepper">
          <view class="step-btn" data-index="{{index}}" bindtap="cartMinus"
                aria-role="button" aria-label="减少{{item.name}}数量">−</view>
          <view class="step-num" aria-label="数量 {{item.quantity}}">{{item.quantity}}</view>
          <view class="step-btn" data-index="{{index}}" bindtap="cartPlus"
                aria-role="button" aria-label="增加{{item.name}}数量">＋</view>
        </view>
        <view class="cart-remove" data-index="{{index}}" bindtap="cartRemove"
              aria-role="button" aria-label="移除{{item.name}}">移除</view>
      </view>
    </view>
  </view>

  <!-- 顾客手机（选填）：输入 11 位显示"添加"按钮，输入 4 位显示匹配的会员预选 -->
  <view class="field-block">
    <view class="field-label">顾客手机（选填）</view>
    <view class="phone-input-wrap">
      <input class="field-input phone-input" type="number" placeholder="11 位手机号" value="{{customerPhone}}"
             bindinput="onPhoneInput" placeholder-class="ph" maxlength="11" aria-label="顾客手机号" />
      <view class="add-customer-btn" wx:if="{{showAddCustomerBtn}}" bindtap="onAddCustomerTap">+ 添加会员</view>
    </view>
    <view class="phone-count {{customerPhone.length === 11 ? 'done' : ''}}">{{customerPhone.length}} / 11</view>

    <!-- 会员预选：输入 4 位后显示匹配的老客户 -->
    <view class="customer-matches" wx:if="{{customerMatches.length > 0}}">
      <view class="customer-matches-title">可能会员（{{customerMatches.length}}）</view>
      <view class="customer-match-item" wx:for="{{customerMatches}}" wx:key="phone"
            data-phone="{{item.phone}}" data-name="{{item.displayName}}" bindtap="onSelectCustomer">
        <text class="match-name">{{item.displayName}}</text>
        <text class="match-phone">{{item.phone}}</text>
      </view>
    </view>
  </view>

  <!-- 订单备注 -->
  <view class="field-block">
    <view class="field-label">订单备注</view>
    <textarea class="field-textarea" placeholder="改裤长、改期取件..." value="{{remark}}"
              bindinput="onRemarkInput" placeholder-class="ph" auto-height maxlength="200"
              aria-label="订单备注" />
  </view>

  <!-- 底部结算栏：固定并与 TabBar 拼接 -->
  <view class="footer-bar {{dockPulling ? 'dock-pulling' : ''}} {{dockHidden ? 'dock-hidden' : ''}}" bindanimationend="onDockPullEnd">
    <view class="footer-left">
      <view class="footer-spec">{{cart.length}} 种规格</view>
      <view class="footer-price">¥{{totalAmount}}</view>
    </view>
    <view class="footer-btn {{cart.length === 0 || submitting ? 'disabled' : ''}} {{submitting ? 'btn-loading' : ''}}" bindtap="submitOrder"
          aria-role="button" aria-label="收款并出单，共 {{totalQuantity}} 件，合计 {{totalAmount}} 元">
      {{submitting ? '提交中…' : '收款并出单'}}
    </view>
  </view>

  <!-- 规格选择弹层 -->
  <view wx:if="{{selectVisible}}" class="mask" bindtap="closeSelect">
    <view class="modal" catchtap="noop">
      <view class="modal-title">{{selGoods.name}}</view>
      <view wx:if="{{selColors.length}}">
        <view class="spec-label">颜色</view>
        <view class="spec-row">
          <view wx:for="{{selColors}}" wx:key="value"
                class="spec-item {{selColor === item.value ? 'spec-active' : ''}} {{item.low ? 'spec-low' : ''}}"
                data-v="{{item.value}}" bindtap="pickColor">
            <text>{{item.value}}</text>
            <text wx:if="{{item.recent}}" class="spec-recent">常选</text>
          </view>
        </view>
      </view>
      <view wx:if="{{selSizes.length}}">
        <view class="spec-label">尺码</view>
        <view class="spec-row">
          <view wx:for="{{selSizes}}" wx:key="value"
                class="spec-item {{selSize === item.value ? 'spec-active' : ''}} {{item.low ? 'spec-low' : ''}}"
                data-v="{{item.value}}" bindtap="pickSize">
            <text>{{item.value}}</text>
            <text wx:if="{{item.recent}}" class="spec-recent">常选</text>
          </view>
        </view>
      </view>
      <view class="spec-label {{selSkuStock < 5 ? 'spec-label-low' : ''}}">
        数量（该规格库存 {{selSkuStock}}）
        <text wx:if="{{selSkuStock < 5}}" class="spec-low-tip">库存紧张</text>
      </view>
      <view class="stepper big-stepper">
        <view class="step-btn" bindtap="selQtyMinus">−</view>
        <view class="step-num">{{selQty}}</view>
        <view class="step-btn" bindtap="selQtyPlus" bindlongpress="selQtyLongPress">＋</view>
      </view>
      <view class="spec-tip">长按 + 可一次加 5 件</view>
      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeSelect">取消</button>
        <button class="btn-primary modal-btn primary {{addingItem ? 'btn-loading' : ''}}" bindtap="confirmAdd">加入订单</button>
      </view>
    </view>
  </view>
  </block>

  <!-- 开单成功卡片（替代系统 modal：可继续开单 / 查看订单 / 补打小票） -->
  <view wx:if="{{successInfo}}" class="mask" bindtap="closeSuccess">
    <view class="modal success-modal" catchtap="noop">
      <view class="success-icon icon icon-check-circle"></view>
      <view class="success-title">开单成功</view>
      <view class="success-order">{{successInfo.orderNo}}</view>
      <view class="success-amount">￥{{successInfo.totalAmount}}</view>
      <view class="success-status {{successInfo.paid ? 'paid' : 'pending'}}">
        {{successInfo.paid ? '已标记收款' : '待收款'}}
      </view>
      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeSuccess">继续开单</button>
        <button class="btn-primary modal-btn primary" bindtap="goOrderFromSuccess">查看订单</button>
      </view>
      <view class="success-reprint" bindtap="reprintFromSuccess">补打小票</view>
    </view>
  </view>

  <!-- 添加会员弹窗：输入姓氏 + 选择性别 -->
  <view wx:if="{{addCustomerVisible}}" class="mask" bindtap="closeAddCustomer">
    <view class="modal" catchtap="noop">
      <view class="modal-title">添加会员</view>
      <view class="modal-sub">手机号 {{customerPhone}}</view>

      <view class="form-item">
        <view class="form-label">姓氏</view>
        <input class="form-input" placeholder="如：赵" value="{{newCustomerSurname}}"
               bindinput="onNewCustomerSurnameInput" placeholder-class="ph" maxlength="10" />
      </view>

      <view class="form-item">
        <view class="form-label">性别</view>
        <view class="gender-options">
          <view class="gender-option {{newCustomerGender === 1 ? 'active' : ''}}"
                data-gender="1" bindtap="onNewCustomerGenderTap">先生</view>
          <view class="gender-option {{newCustomerGender === 2 ? 'active' : ''}}"
                data-gender="2" bindtap="onNewCustomerGenderTap">女士</view>
        </view>
      </view>

      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeAddCustomer">取消</button>
        <button class="btn-primary modal-btn primary" bindtap="confirmAddCustomer">确认添加</button>
      </view>
    </view>
  </view>
</view>
