/* 店铺页样式（清透质感：Hero 店铺卡 + Standard 功能卡 + Overlay 弹窗） */
.store-page {
  min-height: 100vh;
  background: transparent;
  padding: 40rpx 40rpx calc(var(--space-tabbar-bottom, 124rpx) + env(safe-area-inset-bottom) + 96rpx);
  box-sizing: border-box;
}

.store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.store-title {
  font-size: var(--font-h2);
  font-weight: bold;
  color: var(--text-1);
}
.store-back {
  font-size: 26rpx;
  color: var(--primary-dark);
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.4);
}

/* 店铺头部：Hero 白玻璃（透光 + 高浮层阴影）；高度由拖拽逻辑控制 */
.store-card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.62);
  border-radius: var(--radius-hero);
  padding: 48rpx 40rpx 88rpx; /* 底部预留右下角拖拽把手空间 */
  box-shadow: var(--shadow-float), var(--inner-light);
  border: 1rpx solid var(--glass-border);
  transition: height 0.28s var(--ease-spring);
}
.store-card.is-dragging {
  transition: none;
}
/* 无成员且无可注册内容：隐藏把手，底部不再预留把手空间 */
.store-card.is-static {
  padding-bottom: 48rpx;
}

/* 未绑定店铺引导卡 */
.guide-card {
  background: var(--bg-card);
  border-radius: var(--radius-hero);
  padding: 72rpx 40rpx 56rpx;
  text-align: center;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
}
.guide-icon {
  font-size: 96rpx;
  color: var(--primary);
  opacity: 0.55;
  margin-bottom: 24rpx;
}
.guide-title {
  font-size: var(--font-h3);
  font-weight: 700;
  color: var(--text-1);
}
.guide-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 16rpx;
  line-height: 1.6;
}
.guide-btn {
  display: block;
  width: 320rpx;
  margin: 32rpx auto 0;
  font-size: 28rpx;
}
.store-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.store-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-1);
}

.switch-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  color: var(--text-2);
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}
.switch-icon:active {
  color: var(--primary);
}

.member-section {
  padding: 32rpx 4rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.register-btn {
  margin-top: 40rpx;
  font-size: 32rpx;
}

/* 切换店铺弹窗：Overlay 浮层 */
.popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 25, 40, 0.32);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}
.popup-panel {
  width: 580rpx;
  background: var(--bg-overlay);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-hero);
  padding: 40rpx 36rpx 28rpx;
  box-shadow: var(--shadow-float), var(--inner-light);
  -webkit-backdrop-filter: blur(26px) saturate(150%);
  backdrop-filter: blur(26px) saturate(150%);
  animation: modal-in var(--duration-slow) var(--ease-spring) both;
}
.popup-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
  text-align: center;
  margin-bottom: 16rpx;
}
.popup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 28rpx;
  color: var(--text-1);
}
.popup-item:last-of-type {
  border-bottom: none;
}
.popup-item.current .popup-store-name {
  color: var(--primary-dark);
  font-weight: bold;
}
.popup-store-name {
  flex: 1;
}
.popup-store-tag {
  font-size: 22rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: 999rpx;
  padding: 4rpx 24rpx;
  line-height: 1.6;
}
.popup-store-arrow {
  font-size: 24rpx;
  color: var(--primary-dark);
  border: 1rpx solid var(--glass-border);
  background: rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  padding: 4rpx 24rpx;
  line-height: 1.6;
}
.popup-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 16rpx 0;
}
.store-role {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: var(--radius-sm);
  padding: 8rpx 16rpx;
}

/* 店铺码卡片：Dense 密集层 */
.code-box {
  margin-top: 40rpx;
  background: var(--bg-card-strong);
  border-radius: var(--radius-input);
  padding: 32rpx 24rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-soft-1);
}
.code-label {
  font-size: 22rpx;
  color: var(--text-2);
  flex: 1;
}

.code-head {
  display: flex;
  align-items: center;
}
.reset-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid var(--glass-border);
  color: var(--primary-dark);
  background: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.code-value {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: var(--primary-dark);
  display: flex;
  align-items: center;
}
.code-copy {
  margin-left: 16rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  color: #fff;
  background: linear-gradient(135deg, #8a9bf9 0%, #b3a1fb 100%);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.store-btns {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.store-btns .btn-primary,
.store-btns .btn-ghost {
  font-size: 28rpx;
}

.member-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 12rpx;
}
.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 28rpx;
  color: var(--text-1);
}
.member-item:last-child {
  border-bottom: none;
}
.member-role {
  font-size: 22rpx;
  color: var(--text-2);
}
.role-owner {
  color: var(--primary-dark);
  font-weight: bold;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.member-remove {
  font-size: 24rpx;
  color: var(--danger);
  background: var(--danger-tint);
  border: none;
  border-radius: 999rpx;
  padding: 4rpx 24rpx;
  line-height: 1.6;
}

/* ===== 拉伸展开交互 ===== */
/* 展开区：高度由 JS 跟随手指设置，overflow 裁剪内容 */
.expand-area {
  overflow: hidden;
  transition: height 0.28s var(--ease-spring);
}
/* 收起动画期间内容仍可能短暂可见，禁用点击避免误触 */
.expand-area.is-closed {
  pointer-events: none;
}
.expand-inner {
  padding-top: 16rpx;
}
.store-card.is-dragging .expand-area {
  transition: none;
}

/* 右下角拖拽把手：收起态下拉展开，展开态上拖收起 */
.drag-handle-bottom {
  position: absolute;
  right: 32rpx;
  bottom: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: var(--shadow-soft-1);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  transition: transform var(--duration-fast) var(--ease-spring);
  transform-origin: center;
}
.drag-handle-bottom:active {
  background: rgba(255, 255, 255, 0.78);
}
/* 拖拽中把手轻微缩放，给出「已抓取」的触感反馈 */
.store-card.is-dragging .drag-handle-bottom {
  transform: scale(0.95);
}
.drag-handle-bar {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--text-3);
  flex-shrink: 0;
}
.drag-handle-hint {
  font-size: 22rpx;
  line-height: 1;
  color: var(--text-2);
  white-space: nowrap;
  /* 避免用透明度压低小字号提示的对比度；拖拽时改用文字色阶高亮 */
  transition: color var(--duration-fast) var(--ease-out);
}
.store-card.is-dragging .drag-handle-hint {
  color: var(--text-1);
}

/* 功能卡：Standard 玻璃 */
.platform-card {
  margin-top: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
  transition: transform var(--duration-fast) var(--ease-out);
}
.platform-card:active {
  transform: scale(var(--scale-press));
}
.platform-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.platform-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.platform-arrow {
  font-size: 44rpx;
  color: var(--text-3);
  line-height: 1;
}

.page-bottom-space {
  height: 40rpx;
}

.settings-card {
  margin-top: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 0 40rpx;
  box-shadow: var(--shadow-soft-2), var(--inner-light);
  border: 1rpx solid var(--glass-border);
}
.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  font-size: 30rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--hairline);
}
.settings-item:last-child {
  border-bottom: none;
}
.settings-arrow {
  font-size: var(--font-h3);
  color: var(--text-3);
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .store-card,
  .code-box {
    background: #ffffff;
  }
  .popup-panel {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .store-back,
  .popup-store-arrow,
  .reset-icon,
  .drag-handle-bottom {
    background: #f4f6fa;
  }
  .drag-handle-bottom {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .store-card,
  .expand-area,
  .platform-card,
  .popup-panel,
  .drag-handle-bottom,
  .drag-handle-hint {
    transition: none !important;
    animation: none !important;
  }
  .platform-card:active {
    transform: none;
  }
}
