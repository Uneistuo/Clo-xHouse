/* 店铺页样式（优化版：CSS 变量） */
.store-page {
  min-height: 100vh;
  background: var(--bg-app);
  padding: 40rpx 40rpx 180rpx;
  box-sizing: border-box;
}

.store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.store-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-1);
}
.store-back {
  font-size: 26rpx;
  color: var(--primary-dark);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--primary-dark);
  border-radius: 28rpx;
}

.store-card {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-2);
  border: 1rpx solid var(--border);
}
.store-name-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.store-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-1);
}

.switch-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  color: var(--text-2);
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}
.switch-icon:active {
  color: var(--primary);
}

.member-section {
  margin-top: 44rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--divider);
}

.register-btn {
  margin-top: 40rpx;
  font-size: 32rpx;
}

.popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 26, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-panel {
  width: 580rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 40rpx 36rpx 28rpx;
  box-shadow: var(--shadow-3);
}
.popup-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
  text-align: center;
  margin-bottom: 16rpx;
}
.popup-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--divider);
  font-size: 28rpx;
  color: var(--text-1);
}
.popup-item:last-of-type {
  border-bottom: none;
}
.popup-item.current .popup-store-name {
  color: var(--primary-dark);
  font-weight: bold;
}
.popup-store-name {
  flex: 1;
}
.popup-store-tag {
  font-size: 22rpx;
  color: #fff;
  background: var(--primary-dark);
  border-radius: 999rpx;
  padding: 4rpx 22rpx;
  line-height: 1.6;
}
.popup-store-arrow {
  font-size: 24rpx;
  color: var(--primary-dark);
  border: 1rpx solid var(--primary-tint);
  border-radius: 999rpx;
  padding: 4rpx 26rpx;
  line-height: 1.6;
}
.popup-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 12rpx 0;
}
.store-role {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: var(--primary-tint);
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
}

.code-box {
  margin-top: 40rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--border);
}
.code-label {
  font-size: 22rpx;
  color: var(--text-2);
  flex: 1;
}

.code-head {
  display: flex;
  align-items: center;
}
.reset-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid var(--primary-tint);
  color: var(--primary-dark);
  background: var(--bg-card);
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.code-value {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: var(--primary-dark);
  display: flex;
  align-items: center;
}
.code-copy {
  margin-left: 20rpx;
  font-size: 22rpx;
  letter-spacing: 0;
  color: #fff;
  background: var(--primary-dark);
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
}

.store-btns {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.store-btns .btn-primary,
.store-btns .btn-ghost {
  font-size: 28rpx;
}

.member-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-1);
  margin-bottom: 12rpx;
}
.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
  font-size: 28rpx;
  color: var(--text-1);
}
.member-item:last-child {
  border-bottom: none;
}
.member-role {
  font-size: 22rpx;
  color: var(--text-2);
}
.role-owner {
  color: var(--primary-dark);
  font-weight: bold;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.member-remove {
  font-size: 24rpx;
  color: var(--danger);
  border: 1rpx solid var(--danger-tint);
  border-radius: 999rpx;
  padding: 4rpx 26rpx;
  line-height: 1.6;
}

.fold-toggle {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 36rpx;
  background: var(--text-2);
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.fold-toggle-hover {
  background: #4a4f58;
}
.fold-toggle::before,
.fold-toggle::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 14rpx;
  height: 14rpx;
  pointer-events: none;
}
.fold-toggle::before {
  left: -14rpx;
  background: radial-gradient(circle 14rpx at 0 0, transparent 13rpx, var(--text-2) 14rpx);
}
.fold-toggle::after {
  right: -14rpx;
  background: radial-gradient(circle 14rpx at 100% 0, transparent 13rpx, var(--text-2) 14rpx);
}
.fold-toggle-arrow {
  position: relative;
  z-index: 1;
  display: inline-block;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
  margin-top: -2rpx;
}
.fold-arrow-up {
  transform: rotate(180deg);
}

.platform-card {
  margin-top: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border);
}
.platform-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-1);
}
.platform-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.platform-arrow {
  font-size: 44rpx;
  color: var(--text-2);
  line-height: 1;
}

.page-bottom-space {
  height: 40rpx;
}

.settings-card {
  margin-top: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 0 40rpx;
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--border);
}
.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 0;
  font-size: 30rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--divider);
}
.settings-item:last-child {
  border-bottom: none;
}
.settings-arrow {
  font-size: 34rpx;
  color: var(--text-2);
}
