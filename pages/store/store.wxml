<page-meta page-style="{{pageStyle}}"></page-meta>
<!--店铺页（tab）：店铺信息+成员合并板块；圆形图标弹窗切换店铺；底部注册店铺（店主，上限3家）-->
<view class="store-page">
  <view class="store-head">
    <view class="store-title">我的店铺</view>
  </view>

  <!-- ===== 已绑定店铺：店铺信息（名称/店铺码）+ 可拉伸展开的成员区 ===== -->
  <view class="store-card {{isDragging ? 'is-dragging' : ''}} {{canExpandMembers ? '' : 'is-static'}}"
        style="height: {{cardHeight ? cardHeight + 'rpx' : 'auto'}};"
        wx:if="{{storeId}}">
    <!-- 店铺名称 + 切换店铺图标（仅图标，无圆圈与背景） -->
    <view class="store-name-row">
      <view class="store-name">{{store.name}}</view>
      <view class="switch-icon" wx:if="{{role === 'owner' && myStores.length}}" bindtap="openSwitchPopup"><view class="icon icon-swap"></view></view>
    </view>
    <view class="store-role">{{role === 'owner' ? '店主' : '员工'}}</view>

    <view class="code-box">
      <view class="code-head">
        <view class="code-label">店铺码</view>
        <view class="reset-icon" wx:if="{{role === 'owner'}}" bindtap="handleResetCode"><view class="icon icon-refresh"></view></view>
      </view>
      <view class="code-value" bindtap="handleCopyCode">
        {{store.bind_code}} <text class="code-copy">复制</text>
      </view>
    </view>

    <view class="store-btns" wx:if="{{role !== 'owner'}}">
      <button class="btn-ghost" bindtap="handleUnbind">退出店铺</button>
    </view>

    <!-- 展开区域：高度跟随拖拽，内容溢出裁剪 -->
    <view class="expand-area {{membersExpanded ? '' : 'is-closed'}}"
          style="height: {{expandHeight}}rpx;"
          aria-hidden="{{!membersExpanded}}">
      <view class="expand-inner">
        <!-- 店铺成员（与店铺信息同一板块） -->
        <view class="member-section">
          <view class="member-title">店铺成员（{{members.length}}）</view>
          <view class="member-item" wx:for="{{members}}" wx:key="id">
            <view class="member-info">
              <view class="member-name">{{item.username}}</view>
              <view class="member-role {{item.role === 'owner' ? 'role-owner' : ''}}">
                {{item.role === 'owner' ? '店主' : '员工'}}
              </view>
            </view>
            <view class="member-remove" wx:if="{{role === 'owner' && item.role !== 'owner'}}"
                  data-id="{{item.id}}" data-name="{{item.username}}" bindtap="handleRemoveMember">移除</view>
          </view>

          <!-- 注册店铺：店主名下不满 3 家时显示（满 3 家自动隐藏） -->
          <button class="btn-primary register-btn" wx:if="{{role === 'owner' && canCreateStore}}"
                  bindtap="handleCreateNew" disabled="{{loading}}">注册店铺</button>
        </view>
      </view>
    </view>

    <!-- 右下角把手：收起态下拉展开，展开态上拖收起 -->
    <view class="drag-handle-bottom"
          wx:if="{{canExpandMembers}}"
          data-mode="{{membersExpanded ? 'collapse' : 'expand'}}"
          aria-role="button"
          aria-label="{{membersExpanded ? '收起店铺成员' : '展开店铺成员'}}"
          bindtouchstart="onDragStart"
          catchtouchmove="onDragMove"
          bindtouchend="onDragEnd"
          bindtouchcancel="onDragCancel">
      <view class="drag-handle-bar"></view>
      <view class="drag-handle-hint">{{membersExpanded ? '收起' : '下拉查看成员'}}</view>
    </view>
  </view>

  <view wx:else class="guide-card">
    <view class="guide-icon icon icon-store"></view>
    <view class="guide-title">还没有绑定店铺？</view>
    <view class="guide-sub">注册账号后即可创建或加入店铺</view>
    <button class="btn-primary guide-btn" bindtap="goRegister">去注册</button>
  </view>

  <!-- ===== 会员客户：已绑定店铺才显示（会员列表/消费记录/CRM） ===== -->
  <view class="platform-card" wx:if="{{storeId}}" bindtap="goCustomers">
    <view class="platform-info">
      <view class="platform-title">会员客户</view>
      <view class="platform-sub">管理会员信息与消费记录</view>
    </view>
    <view class="platform-arrow icon icon-chevron-right"></view>
  </view>

  <!-- ===== 打印设置：已绑定店铺才显示（开单需要小票） ===== -->
  <view class="platform-card" wx:if="{{storeId}}" bindtap="goPrinter">
    <view class="platform-info">
      <view class="platform-title">打印设置</view>
      <view class="platform-sub">{{printerHint}}</view>
    </view>
    <view class="platform-arrow icon icon-chevron-right"></view>
  </view>

  <!-- ===== 平台管理入口：仅平台管理员可见（控制各店铺开单白名单时效） ===== -->
  <view class="platform-card" wx:if="{{isPlatform}}" bindtap="goPlatform">
    <view class="platform-info">
      <view class="platform-title">平台管理</view>
      <view class="platform-sub">控制各店铺开单授权时效</view>
    </view>
    <view class="platform-arrow icon icon-chevron-right"></view>
  </view>

  <!-- ===== 设置 ===== -->
  <view class="settings-card">
    <view class="settings-item" bindtap="handleLogout">
      <text class="settings-label">退出登录</text>
      <view class="settings-arrow icon icon-chevron-right"></view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
</view>

<!-- ===== 切换店铺弹窗（店主名下店铺列表） ===== -->
<view class="popup-mask" wx:if="{{showSwitchPopup}}" bindtap="closeSwitchPopup">
  <view class="popup-panel" catchtap="noop">
    <view class="popup-title">切换店铺</view>
    <view class="popup-item {{item.id === storeId ? 'current' : ''}}"
          wx:for="{{myStores}}" wx:key="id"
          data-id="{{item.id}}" data-name="{{item.name}}" bindtap="handleSwitchStore">
      <view class="popup-store-name">{{item.name}}</view>
      <view class="popup-store-tag" wx:if="{{item.id === storeId}}">当前</view>
      <view class="popup-store-arrow" wx:else>切换</view>
    </view>
    <view class="popup-cancel" bindtap="closeSwitchPopup">取消</view>
  </view>
</view>
