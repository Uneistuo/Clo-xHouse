@import '../styles/icons.wxss';
@import '../styles/tokens.wxss';

/* ============================================================
   自定义底部导航（裁间）—— 悬浮 Wash 玻璃胶囊
   栏高 108rpx，左右各留 24rpx，距底部安全区 16rpx；
   中间"开单"为绝对定位的凸起圆钮，浮在栏上方，不影响栏高。

   ⚠️ 自定义 tabBar 是组件（样式隔离），tokens.wxss 里的
      page / :host 变量可能传不进来。因此所有 var() 均带兜底色值，
      取不到变量时回退为新版设计稿的固定色，避免背景失效变透明。
   ============================================================ */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(var(--space-tabbar-gap, 16rpx) + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  height: var(--space-tabbar-height, 108rpx);
  box-sizing: border-box;
  background-color: rgba(255, 255, 255, 0.4);
  border: 1rpx solid var(--glass-border, rgba(255, 255, 255, 0.72));
  border-radius: 36rpx;
  box-shadow: var(--shadow-float, 0 24rpx 60rpx rgba(35, 45, 75, 0.12));
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  backdrop-filter: blur(14px) saturate(140%);
}
/* ===== 拼接态：与结算栏 / 批量栏拼成同一块面板 =====
   两块面板在交界处必须都是直角，否则栏体自己的内圆角会在接缝上
   各切出一个缺口，看起来就是「拼接处冒出两个圆角」。

   所以拼接态直接改栏体自身的圆角 / 底色 / 模糊，并且不加 transition：
     · 单帧完成，不像插值圆角那样每帧重新裁剪背景再重新模糊；
     · 跨页切换时栏体本来就在首帧直接画出目标态（缓存页甚至不再重播动画），
       这一跳看不见；页内切换（商品批量管理）时与面板同时落位；
     · 底色与两块底部面板一致，接缝处没有色差；
     · 拼成整块后不需要玻璃感，顺手关掉 backdrop-filter：
       面板从后方拉出时就不会每帧重新采样一次模糊。 */
.tabbar-docked {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-top-color: transparent;
  background-color: var(--dock-bg, rgba(255, 255, 255, 0.94));
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
/* 首帧（页面 onShow 同步 dock 的那一次）不播任何形变 */
.tabbar:not(.tabbar-anim) .tabbar-icon-wrap,
.tabbar:not(.tabbar-anim) .tabbar-icon-wrap::before,
.tabbar:not(.tabbar-anim) .tabbar-icon,
.tabbar:not(.tabbar-anim) .tabbar-text,
.tabbar:not(.tabbar-anim) .tabbar-item::before {
  transition: none !important;
}

.tabbar-item {
  position: relative;
  z-index: 1; /* 压在栏体底色之上 */
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
  box-sizing: border-box;
  color: var(--text-3, #97a0ae);
  font-size: 22rpx;
  transition: color 0.15s ease;
}
.tabbar-item.active {
  color: var(--primary, #7b8cf7);
}

/* 选中态：图标 + 文字后垫主色浅底圆角胶囊 */
.tabbar-item::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  bottom: 8rpx;
  width: 104rpx;
  transform: translateX(-50%);
  border-radius: 32rpx;
  background: transparent;
  transition:
    background 0.15s ease,
    opacity 0.2s ease;
  pointer-events: none;
}
.tabbar-item.active::before {
  background: var(--primary-tint, rgba(123, 140, 247, 0.12));
}
.tabbar-item-middle::before {
  opacity: 0;
}

.tabbar-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.tabbar-item.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
}
.tabbar-icon {
  font-size: 44rpx;
  transition:
    transform 0.12s ease,
    opacity 0.12s ease;
}
.tabbar-text {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  line-height: 1.1;
  transition: opacity 0.12s ease;
}

/* 按下反馈：5 个按键统一（图标缩小 + 图标文字变淡），与选中上浮互不冲突 */
.tabbar-item:active .tabbar-icon {
  transform: scale(0.88);
  opacity: 0.7;
}
.tabbar-item:active .tabbar-text {
  opacity: 0.7;
}

/* ===== 中间凸起"开单"：绝对定位，浮于栏上方 =====
   几何完全走 transform（抬升 28rpx + 圆钮缩放），
   不再插值 top / width / height —— 那三项每帧都会触发一次布局。 */
.tabbar-item-middle .tabbar-icon-wrap {
  position: absolute;
  /* 基准 = 平铺态：与普通 Tab 图标同尺寸、同位置 */
  top: 20rpx;
  left: 0;
  right: 0;
  margin: 0 auto;
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  /* 凸起：上移 28rpx（圆心由 42rpx 抬到 14rpx） */
  transform: translateY(-28rpx);
  /* 只用于按下反馈：必须够快。拼接态形变由 keyframes 驱动（0.28s），
     动画优先级高于过渡，因此这里改短不影响凸起/收平的速度。 */
  transition: transform 0.16s var(--ease-out, cubic-bezier(0, 0, 0.2, 1));
}
/* 圆形底衬独立一层：尺寸固定 108rpx，用 scale + opacity 完成
   "凸起圆钮 → 普通 Tab" 的形变（渐变与圆角都不参与插值） */
.tabbar-item-middle .tabbar-icon-wrap::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 108rpx;
  height: 108rpx;
  margin: -54rpx 0 0 -54rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary, #7b8cf7) 0%, var(--primary-dark, #6675e8) 100%);
  border: 6rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--shadow-primary, 0 16rpx 36rpx rgba(123, 140, 247, 0.26));
  opacity: 1;
  transform: scale(1);
  transition:
    opacity 0.2s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)),
    transform 0.28s var(--ease-out, cubic-bezier(0, 0, 0.2, 1));
  pointer-events: none;
}
.tabbar-item-middle.active .tabbar-icon-wrap {
  transform: translateY(-30rpx);
}
.tabbar-item-middle:active .tabbar-icon-wrap {
  transform: translateY(-28rpx) scale(var(--scale-press-dock, 0.94));
}
.tabbar-item-middle .tabbar-icon {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 44rpx;
  transition:
    color 0.24s ease,
    transform 0.12s ease,
    opacity 0.12s ease;
}
.tabbar-item-middle .tabbar-text {
  color: var(--primary, #7b8cf7);
  font-weight: 600;
  transition:
    opacity 0.12s ease,
    color 0.24s ease;
}

/* ===== 开单页 / 底部栏拼接态：中间"开单"回归普通 Tab（避免凸起被底部栏遮挡） ===== */
.tabbar-billing .tabbar-item-middle::before,
.tabbar-docked .tabbar-item-middle::before {
  opacity: 1;
}
.tabbar-billing .tabbar-item-middle .tabbar-icon-wrap,
.tabbar-docked .tabbar-item-middle .tabbar-icon-wrap {
  transform: none;
}
.tabbar-billing .tabbar-item-middle .tabbar-icon-wrap::before,
.tabbar-docked .tabbar-item-middle .tabbar-icon-wrap::before {
  opacity: 0;
  transform: scale(0.6);
}
.tabbar-billing .tabbar-item-middle .tabbar-icon,
.tabbar-docked .tabbar-item-middle .tabbar-icon {
  color: var(--primary, #7b8cf7);
}
.tabbar-billing .tabbar-item-middle.active .tabbar-icon-wrap,
.tabbar-docked .tabbar-item-middle.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
}
.tabbar-billing .tabbar-item-middle:active .tabbar-icon-wrap,
.tabbar-docked .tabbar-item-middle:active .tabbar-icon-wrap {
  transform: scale(0.88);
}

/* 拼接态也可能出现在非开单页（如商品批量）：中间 Tab 回到未选中配色 */
.tabbar-docked .tabbar-item-middle .tabbar-icon,
.tabbar-docked .tabbar-item-middle .tabbar-text {
  color: var(--text-3, #97a0ae);
  font-weight: 400;
}
.tabbar-docked .tabbar-item-middle.active .tabbar-icon,
.tabbar-docked .tabbar-item-middle.active .tabbar-text {
  color: var(--primary, #7b8cf7);
  font-weight: 600;
}

/* ============================================================
   跨页切换动画 a / b / c / d
   由 switch.js 判定后以类名下发，四种场景：
     a 拼接 → 拼接  面板与栏体都在位，不位移，只让高亮胶囊淡入
     b 拼接 → 普通  栏体单帧收回圆角（见 .tabbar-docked），中间键抬起
     c 普通 → 拼接  栏体单帧收方，中间键收平，页面面板从栏后拉出
     d 普通 → 普通  没有面板可拼，5 个按键轻轻落位一次

   栏体自身的形变（圆角 / 底色 / 模糊）一律不做插值，见 .tabbar-docked：
   那三项每帧都要重新裁剪并重新模糊，正是之前卡顿的主因。
   其余 keyframes 一律「只写 from」：to 自动取元素自身样式，
   所以动画终点就是目标态，类名被清掉时不会跳一帧。
   ============================================================ */

/* a：栏体连续，只做高亮过渡 */
.tabbar-switch-a .tabbar-item.active::before {
  animation: tabbar-pill-in 0.2s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}

/* b：拼接 → 普通；c：普通 → 拼接
   栏体的圆角 / 底色在 .tabbar-docked 里单帧切换（见文件开头），不做插值，
   因此这两个方向只剩下「中间开单键」的形变（见下方 tabbar-mid-*），
   外加 c 时页面自己那块面板从栏后拉出。 */

/* d：普通 → 普通 */
.tabbar-switch-d .tabbar-item {
  animation: tabbar-item-settle 0.22s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}

/* 中间「开单」键：与拼接态解耦（开单页不拼接时也平铺），按方向单独播。
   形变期间提前提升图层（类名清理时自动撤销），避免每帧重新栅格化圆钮投影。 */
.tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap,
.tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap,
.tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap::before,
.tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap::before {
  will-change: transform, opacity;
}
.tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap {
  animation: tabbar-mid-raise 0.28s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}
.tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap::before {
  animation: tabbar-mid-plate-raise 0.28s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}
.tabbar-mid-raise .tabbar-item-middle .tabbar-icon {
  animation: tabbar-mid-icon-raise 0.24s ease both;
}

.tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap {
  animation: tabbar-mid-flatten 0.28s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}
.tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap::before {
  animation: tabbar-mid-plate-flatten 0.28s var(--ease-out, cubic-bezier(0, 0, 0.2, 1)) both;
}
.tabbar-mid-flatten .tabbar-item-middle .tabbar-icon {
  animation: tabbar-mid-icon-flatten 0.24s ease both;
}

@keyframes tabbar-pill-in {
  from {
    opacity: 0;
  }
}
@keyframes tabbar-item-settle {
  from {
    opacity: 0.5;
    transform: translateY(6rpx);
  }
}
/* 中间键：只插值 transform（起手位置取另一态） */
@keyframes tabbar-mid-raise {
  from {
    transform: none;
  }
}
@keyframes tabbar-mid-flatten {
  from {
    transform: translateY(-28rpx);
  }
}
/* 圆钮底衬：只插值 opacity + scale */
@keyframes tabbar-mid-plate-raise {
  from {
    opacity: 0;
    transform: scale(0.6);
  }
}
@keyframes tabbar-mid-plate-flatten {
  from {
    opacity: 1;
    transform: scale(1);
  }
}
@keyframes tabbar-mid-icon-raise {
  from {
    color: var(--primary, #7b8cf7);
  }
}
@keyframes tabbar-mid-icon-flatten {
  from {
    color: #ffffff;
  }
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .tabbar,
  .tabbar-docked {
    background-color: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .tabbar-item,
  .tabbar-icon-wrap,
  .tabbar-icon,
  .tabbar-text,
  .tabbar-item::before,
  .tabbar-icon-wrap::before {
    transition: none !important;
  }
  /* 跨页切换动画 a/b/c/d 一并关闭，直接落位 */
  .tabbar-switch-a .tabbar-item.active::before,
  .tabbar-switch-d .tabbar-item,
  .tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap,
  .tabbar-mid-raise .tabbar-item-middle .tabbar-icon-wrap::before,
  .tabbar-mid-raise .tabbar-item-middle .tabbar-icon,
  .tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap,
  .tabbar-mid-flatten .tabbar-item-middle .tabbar-icon-wrap::before,
  .tabbar-mid-flatten .tabbar-item-middle .tabbar-icon {
    animation: none !important;
  }
  /* 只取消普通 Tab 的选中上浮；中间项按原位置落位，不因按下跳一下 */
  .tabbar-item:not(.tabbar-item-middle).active .tabbar-icon-wrap {
    transform: none;
  }
  .tabbar-item-middle:active .tabbar-icon-wrap {
    transform: translateY(-28rpx);
  }
  .tabbar-item-middle.active .tabbar-icon-wrap,
  .tabbar-billing .tabbar-item-middle.active .tabbar-icon-wrap,
  .tabbar-billing .tabbar-item-middle:active .tabbar-icon-wrap,
  .tabbar-docked .tabbar-item-middle.active .tabbar-icon-wrap,
  .tabbar-docked .tabbar-item-middle:active .tabbar-icon-wrap {
    transform: none;
  }
}
