@import '../styles/icons.wxss';
@import '../styles/tokens.wxss';

/* ============================================================
   自定义底部导航（裁间）—— 悬浮 Wash 玻璃胶囊
   栏高 108rpx，左右各留 24rpx，距底部安全区 16rpx；
   中间"开单"为绝对定位的凸起圆钮，浮在栏上方，不影响栏高。

   ⚠️ 自定义 tabBar 是组件（样式隔离），tokens.wxss 里的
      page / :host 变量可能传不进来。因此所有 var() 均带兜底色值，
      取不到变量时回退为新版设计稿的固定色，避免背景失效变透明。
   ============================================================ */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(var(--space-tabbar-gap, 16rpx) + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  height: var(--space-tabbar-height, 108rpx);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx solid var(--glass-border, rgba(255, 255, 255, 0.72));
  border-radius: 36rpx;
  box-shadow: var(--shadow-float, 0 24rpx 60rpx rgba(35, 45, 75, 0.12));
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  backdrop-filter: blur(14px) saturate(140%);
}

.tabbar-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 14rpx;
  box-sizing: border-box;
  color: var(--text-3, #97a0ae);
  font-size: 22rpx;
  transition: color 0.15s ease;
}
.tabbar-item.active {
  color: var(--primary, #7b8cf7);
}

/* 选中态：图标 + 文字后垫主色浅底圆角胶囊 */
.tabbar-item::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  bottom: 6rpx;
  width: 104rpx;
  transform: translateX(-50%);
  border-radius: 32rpx;
  background: transparent;
  transition: background 0.15s ease;
  pointer-events: none;
}
.tabbar-item.active::before {
  background: var(--primary-tint, rgba(123, 140, 247, 0.12));
}
.tabbar-item-middle::before {
  display: none;
}

.tabbar-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.tabbar-item.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
}
.tabbar-icon {
  font-size: 44rpx;
  transition:
    transform 0.12s ease,
    opacity 0.12s ease;
}
.tabbar-text {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  line-height: 1.1;
  transition: opacity 0.12s ease;
}

/* 按下反馈：5 个按键统一（图标缩小 + 图标文字变淡），与选中上浮互不冲突 */
.tabbar-item:active .tabbar-icon {
  transform: scale(0.88);
  opacity: 0.7;
}
.tabbar-item:active .tabbar-text {
  opacity: 0.7;
}

/* ===== 中间凸起"开单"：绝对定位，浮于栏上方 ===== */
.tabbar-item-middle .tabbar-icon-wrap {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 108rpx;
  height: 108rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary, #7b8cf7) 0%, var(--primary-dark, #6675e8) 100%);
  border: 6rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--shadow-primary, 0 16rpx 36rpx rgba(123, 140, 247, 0.26));
}
.tabbar-item-middle.active .tabbar-icon-wrap {
  transform: translateX(-50%) translateY(-2rpx);
}
.tabbar-item-middle:active .tabbar-icon-wrap {
  transform: translateX(-50%) scale(var(--scale-press-dock, 0.94));
}
.tabbar-item-middle .tabbar-icon {
  color: #ffffff;
  font-size: 48rpx;
}
.tabbar-item-middle .tabbar-text {
  color: var(--primary, #7b8cf7);
  font-weight: 600;
}

/* ===== 开单页：与固定结算栏拼接，中间"开单"回归普通 Tab ===== */
.tabbar-billing {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-top-color: transparent;
  background: var(--bg-overlay, rgba(255, 255, 255, 0.82));
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
}
.tabbar-billing .tabbar-item-middle::before {
  display: block;
}
.tabbar-billing .tabbar-item-middle .tabbar-icon-wrap {
  position: relative;
  top: auto;
  left: auto;
  width: auto;
  height: auto;
  transform: none;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.tabbar-billing .tabbar-item-middle .tabbar-icon {
  color: var(--primary, #7b8cf7);
  font-size: 44rpx;
}
.tabbar-billing .tabbar-item-middle.active .tabbar-icon-wrap {
  transform: translateY(-2rpx);
}
.tabbar-billing .tabbar-item-middle:active .tabbar-icon-wrap {
  transform: scale(0.88);
}

/* ===== 无障碍降级 ===== */
@media (prefers-reduced-transparency: reduce) {
  .tabbar {
    background: #ffffff;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .tabbar-item,
  .tabbar-icon-wrap,
  .tabbar-icon,
  .tabbar-text,
  .tabbar-item::before {
    transition: none !important;
  }
  .tabbar-item.active .tabbar-icon-wrap {
    transform: none;
  }
  .tabbar-item-middle:active .tabbar-icon-wrap {
    transform: translateX(-50%);
  }
  .tabbar-billing .tabbar-item-middle.active .tabbar-icon-wrap,
  .tabbar-billing .tabbar-item-middle:active .tabbar-icon-wrap {
    transform: none;
  }
}
