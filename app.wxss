/* ============================================================
   app.wxss 全局样式与设计变量（Design Tokens）
   方向：新零售工作台 · 干净中性底 + 时尚红主色 + 高对比文字
   —— 所有颜色/圆角/阴影统一走变量，换肤只需改这里 ——
   ============================================================ */
@import "styles/icons.wxss";
@import "styles/tokens.wxss";

page {
  background: var(--bg-app);
  color: var(--text-1);
}

/* ========== 通用页面容器 ========== */
.page {
  min-height: 100vh;
  background: var(--bg-app);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-1);
}

/* ========== 按钮 ========== */
.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: var(--shadow-primary);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { background: #f0b4ae; color: #fff; box-shadow: none; }

.btn-ghost {
  background: var(--bg-card);
  color: var(--text-1);
  border: 1.5rpx solid var(--border-strong);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  padding: 14rpx 28rpx;
  display: inline-block;
  text-align: center;
}
.btn-ghost::after { border: none; }

.btn-danger {
  background: var(--bg-card);
  color: var(--danger);
  border: 1.5rpx solid #f0b8b2;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  padding: 14rpx 28rpx;
  display: inline-block;
}
.btn-danger::after { border: none; }

.btn-mini {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  display: inline-block;
  margin-left: 16rpx;
}

/* ========== 表单 ========== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.form-item:last-child { border-bottom: none; }
.form-label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
.form-label.required::before {
  content: "*";
  color: var(--danger);
  margin-right: 4rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  height: 140rpx;
}
.form-arrow { color: var(--text-placeholder); font-size: 26rpx; }
.ph, .placeholder { color: var(--text-placeholder); }

/* ========== 标签 / 徽标 ========== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  margin-right: 12rpx;
}
.tag-blue { background: var(--primary-tint); color: var(--primary-dark); }
.tag-green { background: var(--success-tint); color: var(--success); }
.tag-gray { background: var(--bg-subtle); color: var(--text-2); }
.tag-red { background: var(--danger-tint); color: var(--danger); }
.tag-orange { background: var(--warning-tint); color: var(--warning); }

/* ========== 空状态 ========== */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-3);
  font-size: 26rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }

/* ========== 骨架屏 ========== */
.skeleton {
  background: linear-gradient(90deg, #eef0f3 25%, #f6f7f9 37%, #eef0f3 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 12rpx;
}
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ========== 价格 ========== */
.price { color: var(--primary); font-weight: bold; }
.price-symbol { font-size: 22rpx; }

/* ========== 列表项通用 ========== */
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ========== 分区标题 ========== */
.section-title { font-size: 30rpx; font-weight: bold; color: var(--text-1); margin-bottom: 20rpx; }
.section-tip { font-size: 22rpx; color: var(--text-3); font-weight: normal; }

/* ========== 全局遮罩 / 弹层（各页统一复用，勿再各写一份） ========== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 22, 26, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--bg-card);
  border-radius: var(--radius-sheet);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-3);
}
.modal-title { text-align: center; font-size: 32rpx; font-weight: bold; color: var(--text-1); margin-bottom: 12rpx; }
.modal-sub { text-align: center; font-size: 24rpx; color: var(--text-3); margin-bottom: 24rpx; }
.modal-btns { display: flex; margin-top: 36rpx; }
.modal-btn { flex: 1; }
.modal-btn.primary { margin-left: 24rpx; }

/* ========== 按钮加载状态（统一用于提交按钮） ========== */
.btn-loading {
  position: relative;
  color: transparent !important;
  pointer-events: none;
}
.btn-loading::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  margin-top: -16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: btnSpin 0.8s linear infinite;
}
@keyframes btnSpin {
  to { transform: rotate(360deg); }
}
/* 浅色底按钮的加载转圈（描边为深色） */
.btn-loading.btn-loading-dark::after {
  border-color: rgba(20, 22, 26, 0.15);
  border-top-color: var(--primary);
}

/* ========== 表单内联错误提示 ========== */
.form-error {
  color: var(--danger);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ========== 统一空状态 ========== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--text-3);
}
.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-state-title {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 400;
  margin-bottom: 12rpx;
}
.empty-state-sub {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 40rpx;
}

/* ========== 统一页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: var(--bg-app);
}

/* ========== 列表项（卡片式） ========== */
.list-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
}

/* ========== 输入框聚焦/错误 ========== */
.input-error {
  border-color: var(--danger) !important;
}
.input-error:focus {
  border-color: var(--danger) !important;
  box-shadow: 0 0 0 6rpx rgba(220, 38, 38, 0.08);
}
